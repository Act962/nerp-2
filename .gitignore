# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turborepo
.turbo

# testing
coverage
playwright-report
test-results
blob-report
.playwright

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos os moldes de exemplo, que são versionados de propósito
!**/.env*.example
# ...e menos a URL de produção do desktop: ela é assada em build-time e não
# é segredo. Versionada para que o instalador de release não dependa de
# alguém lembrar de exportar a variável (já gerou build apontando p/ localhost).
!apps/desktop/.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client gerado
**/src/generated

# Configuração local do Claude Code — não versionar
.claude/

# WASM do leitor de código de barras — copiado de node_modules em dev/build
**/public/wasm

# Script local de publicacao do release do desktop: contem as credenciais do R2
# coladas a mao. O molde versionado e subir-release-r2.example.ts.
apps/web/scripts/subir-release-r2.ts

# vite / desktop build
dist

# tauri (build nativo)
apps/desktop/src-tauri/target
apps/desktop/src-tauri/gen
*.stackdump
