{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nerp",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nerp/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nerp/site",
        "dev"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "nerp-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "inngest",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "inngest:dev"
      ],
      "port": 8299
    }
  ]
}
