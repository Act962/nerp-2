{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NERP Caixa",
  "version": "0.1.0",
  "identifier": "com.nerp.caixa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "NERP Caixa",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NASA Sistemas",
    "copyright": "© NASA Sistemas. Todos os direitos reservados.",
    "category": "Business",
    "homepage": "https://nerp.nasaex.com",
    "shortDescription": "Frente de caixa do NERP, com venda offline.",
    "longDescription": "NERP Caixa — frente de caixa do ERP NERP. Pareia o terminal com a organização, mantém o catálogo local e registra vendas mesmo sem internet, sincronizando quando a conexão volta.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installMode": "both"
      }
    }
  }
}
