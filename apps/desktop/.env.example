# Origem do backend NERP que o desktop consome (assada em build-time).
#
# Este molde é para DEV: copie para `.env.local` se precisar apontar para outro
# servidor local. O build de release NÃO usa este arquivo — ele carrega
# `.env.production` (versionado, com a URL pública), e o `vite.config.ts` quebra
# o build se a URL estiver vazia ou apontando para localhost.
VITE_NERP_API_URL="http://localhost:3000"
