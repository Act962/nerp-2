# De onde o site lê o conteúdo publicado (o apps/web).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# O ENDEREÇO PÚBLICO DESTE SITE.
#
# É a base de todo canonical, de todo `og:url`, das imagens de compartilhamento
# e do sitemap. Sem ela tudo isso é resolvido contra `http://localhost:3001` —
# em produção o canonical aponta para a máquina local e o Google descarta a
# página. É a variável mais importante deste arquivo.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Host público do bucket de imagens — o mesmo do apps/web.
NEXT_PUBLIC_S3_BUCKET_CONSTRUCTOR_URL=""

# O segredo que o proxy do consultor manda para o apps/web.
#
# Tem de ser IGUAL ao SITE_ASTRO_TOKEN do apps/web. Sem ele configurado nos
# dois lados a rota de chat do apps/web fica ABERTA (ela deixa passar quando
# não há segredo definido), e qualquer um gasta a cota de LLM da casa.
SITE_ASTRO_TOKEN=""
