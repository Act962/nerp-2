# Copie para `apps/web/.env.test` e suba o banco com `docker compose up -d db-test`.
#
# A suíte de integração TRUNCA tabelas e recusa rodar se o DATABASE_URL não
# tiver "test" no nome — ver apps/web/tests/integration/env.ts.
DATABASE_URL="postgresql://docker:docker@localhost:5434/nerp-test?schema=public"

BETTER_AUTH_SECRET="test-secret-nao-usar-em-producao"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_DOMAIN="localhost:3000"
NEXT_PUBLIC_DOMAIN="http://localhost:3000"
