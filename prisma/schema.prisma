generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================

model User {
  id                       String               @id @default(cuid())
  name                     String
  email                    String               @unique
  emailVerified            Boolean              @default(false)
  image                    String?
  // WhatsApp em E.164 (+55DDDNNNNNNNNN). Obrigatório para o promotor capturar
  // fotos: é como a coordenação identifica e contata quem está em campo.
  whatsapp                 String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  // Relações de autenticação
  sessions                 Session[]
  accounts                 Account[]
  // Relações de organização (mantido do seu schema)
  members                  Member[]
  invitations              Invitation[]
  // Auditoria de ações no ERP
  createdProducts          Product[]            @relation("CreatedProducts")
  createdSales             Sale[]               @relation("CreatedSales")
  createdStockMovements    StockMovement[]      @relation("CreatedStockMovements")
  createdPurchases         Purchase[]           @relation("CreatedPurchases")
  createdKitchenOrders     KitchenOrder[]       @relation("CreatedKitchenOrders")
  kitchenEventsActed       KitchenOrderEvent[]  @relation("KitchenEventsByUser")
  promotionalCatalogs      PromotionalCatalog[]
  createdPdvPhotos         PdvPhoto[]           @relation("CreatedPdvPhotos")
  createdBooks             Book[]               @relation("CreatedBooks")
  createdTradeCatalogs     TradeCatalog[]       @relation("CreatedTradeCatalogs")
  createdPlanograms        Planogram[]          @relation("CreatedPlanograms")
  createdPlanogramVersions PlanogramVersion[]   @relation("CreatedPlanogramVersions")
  authoredAnnotations      MapAnnotation[]      @relation("AuthoredAnnotations")
  editedMapObjects         MapObject[]          @relation("EditedMapObjects")
  createdNegotiations      SpaceNegotiation[]   @relation("CreatedSpaceNegotiations")
  companyClaims            CompanyClaim[]       @relation("UserCompanyClaims")

  @@index([email])
  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Mantido do seu schema - organização ativa na sessão
  activeOrganizationId String?

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================
// ORGANIZAÇÕES (Seu modelo base mantido)
// Renomeado de Company para Organization
// ============================================

enum PlanType {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

model Organization {
  id                        String                        @id @default(cuid())
  name                      String
  slug                      String                        @unique
  logo                      String?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  metadata                  String? // Mantido do seu schema
  // Dados da empresa
  tradeName                 String? // Nome fantasia
  sigla                     String? // Sigla curta da rede p/ Digital Space ID (ex.: "WS")
  document                  String?                       @unique // CNPJ/CPF
  email                     String?
  phone                     String?
  // Multi-tenant e Catálogo
  subdomain                 String?                       @unique // empresa1.seuapp.com
  customDomain              String?                       @unique // minhaloja.com.br
  // Endereço
  address                   String?
  addressNumber             String?
  complement                String?
  neighborhood              String?
  city                      String?
  state                     String?
  zipCode                   String?
  country                   String                        @default("BR")
  // Configurações visuais
  primaryColor              String                        @default("#3b82f6")
  // Vitrine pública PlanoGram: quando true, /planogram/<slug> fica acessível
  // sem login. Opt-in por org — nenhuma rede vira pública sem ligar isto.
  isPublicProfile           Boolean                       @default(false)
  segment                   OrgSegment                    @default(VAREJO)
  // Módulos do NERP que esta empresa NÃO usa — some do menu de todo mundo.
  // Lista de exclusão: default [] = todos ativos, módulo novo entra sozinho.
  disabledModules           String[]                      @default([])
  // Plano e status
  plan                      PlanType                      @default(FREE)
  status                    OrganizationStatus            @default(TRIAL)
  // Limites por plano
  maxProducts               Int                           @default(100)
  maxUsers                  Int                           @default(3)
  // Datas importantes
  trialEndsAt               DateTime?
  subscribedAt              DateTime?
  // Relações de membros (mantido do seu schema)
  members                   Member[]
  invitations               Invitation[]
  joinLinks                 OrganizationJoinLink[]
  // Relações do ERP
  products                  Product[]
  categories                Category[]
  customers                 Customer[]
  suppliers                 Supplier[]
  sales                     Sale[]
  purchases                 Purchase[]
  stockMovements            StockMovement[]
  kitchenColumns            KitchenColumn[]
  kitchenOrders             KitchenOrder[]
  kitchenOrderEvents        KitchenOrderEvent[]
  collaborators             Collaborator[]
  catalogSettings           CatalogSettings?
  financialAccounts         FinancialAccount[]
  transactions              Transaction[]
  catalogUsers              CatalogUser[]
  // Integração NASA (S2S)
  nasaIntegrationConsents   NasaIntegrationConsent[]
  nasaIntegrationKeys       NasaIntegrationKey[]
  promotionalCatalogs       PromotionalCatalog[]
  // Ranking de Equipes (metas de venda)
  salesGoalPeriods          SalesGoalPeriod[]
  salesGoalRankingSettings  SalesGoalRankingSettings?
  // Trade Marketing (lojas, mapa, PDV, book)
  stores                    Store[]
  floorPlans                FloorPlan[]
  mapLayers                 MapLayer[]
  mapObjects                MapObject[]
  brands                    Brand[]
  pdvPhotos                 PdvPhoto[]
  books                     Book[]
  bookCoverTemplate         BookCoverTemplate?
  bookTemplates             BookTemplate[]
  bookPageTemplates         BookPageTemplate[]
  tradeCatalogs             TradeCatalog[]
  planograms                Planogram[]
  planogramFixtures         PlanogramFixture[]
  planogramFixtureTemplates PlanogramFixtureTemplate[]
  planogramItems            PlanogramItem[]
  mapAnnotations            MapAnnotation[]
  spaceNegotiations         SpaceNegotiation[]
  mediaTypes                MediaType[]
  negotiationTypes          NegotiationType[]
  storeSectors              StoreSector[]
  promoterSuppliers         PromoterSupplier[]
  promoterStores            PromoterStore[]
  calendarEvents            CalendarEvent[]
  calendarEventStores       CalendarEventStore[]
  calendarEventSuppliers    CalendarEventSupplier[]
  calendarEventAssignees    CalendarEventAssignee[]
  calendarChecklistItems    CalendarChecklistItem[]
  calendarChecklistDone     CalendarChecklistCompletion[]
  calendarNotes             CalendarNote[]
  calendarNoteTasks         CalendarNoteTask[]
  promoterFavoriteStores    PromoterFavoriteStore[]
  promoterFavoriteSuppliers PromoterFavoriteSupplier[]
  spaceInterests            SpaceInterest[]
  distributors              Distributor[]
  distributorIndustries     DistributorIndustry[]
  storeDistributors         StoreDistributor[]
  promoterDistributors      PromoterDistributor[]
  claimedCompanies          DirectoryCompany[]            @relation("ClaimedCompanies")
  companyClaims             CompanyClaim[]                @relation("OrgCompanyClaims")
  tradeSubscription         TradeSubscription?
  coupons                   Coupon[]
  // Catálogo PDV (precificação)
  mediaTypePrices           MediaTypePrice[]
  tradePricingSettings      TradePricingSettings?
  regionCostBenchmarks      RegionCostBenchmark[]
  // Integração com ERP externo (espelho canônico de vendas)
  erpConnection             ErpConnection?
  externalSellers           ExternalSeller[]
  salesFactsDaily           SalesFactDaily[]
  // Dashboard personalizável
  dashboardManualMetrics    DashboardManualMetric[]
  oracleWidgetSnapshots     OracleWidgetSnapshot[]
  oracleQueryTemplates      OracleQueryTemplate[]
  orgDashboard              OrgDashboard?
  promoterRoutes            PromoterRoute[]

  @@index([slug])
  @@index([subdomain])
  @@index([customDomain])
  @@index([document])
  @@index([status])
  @@map("organization")
}

// Mantido exatamente como seu schema

model Member {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String       @default("member")
  permissions      String[]     @default([]) // chaves de páginas liberadas; owner/admin ignoram
  // Preferência pessoal de menu. Lista de EXCLUSÃO de propósito: default []
  // já significa "vejo tudo" e módulo novo aparece sem backfill.
  hiddenModules    String[]     @default([]) // módulos que este usuário tirou do próprio menu
  dashboardModules String[]     @default([]) // módulos com botão de atalho no dashboard
  createdAt        DateTime     @default(now())
  // Hierarquia de campo: supervisor do promotor (mesma organização)
  supervisorId     String?
  supervisor       Member?      @relation("MemberSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisees      Member[]     @relation("MemberSupervisor")

  // Função no Trade, separada do `role` de acesso: o Better Auth valida `role`
  // contra os cargos do plugin organization, e coordenador/supervisor são
  // papéis do negócio, não níveis de acesso.
  tradeRole           TradeRole?
  // Aparece nas informações carimbadas na foto do App Promotor.
  showInPromotorPhoto Boolean    @default(false)

  salesGoalEntries        SalesGoalEntry[]
  // Vínculos do promotor: indústrias que representa e lojas que cobre. Só pode
  // fotografar uma indústria numa loja se tiver vínculo com AS DUAS.
  promoterSuppliers       PromoterSupplier[]
  promoterStores          PromoterStore[]
  promoterDistributors    PromoterDistributor[]
  favoriteStores          PromoterFavoriteStore[]
  favoriteSuppliers       PromoterFavoriteSupplier[]
  externalSellers         ExternalSeller[]
  dashboardWidgets        DashboardWidget[]
  updatedManualMetrics    DashboardManualMetric[]
  oracleQueryTemplates    OracleQueryTemplate[]
  // Modelo compartilhado da org: autor (opcional) e permissões por widget.
  authoredOrgDashboards   OrgDashboard[]                 @relation("OrgDashboardCreator")
  orgDashboardPermissions OrgDashboardMemberPermission[] @relation("OrgDashboardMemberPermissions")
  authoredCalendarEvents  CalendarEvent[]                @relation("CalendarEventAuthor")
  calendarChecklistDone   CalendarChecklistCompletion[]  @relation("CalendarChecklistDoer")
  calendarNotes           CalendarNote[]                 @relation("CalendarNoteAuthor")
  calendarAssignments     CalendarEventAssignee[]        @relation("CalendarEventAssignee")
  promoterRoute           PromoterRoute?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([supervisorId])
  @@map("member")
}

// Mantido exatamente como seu schema

// Função de campo no Trade. Não é permissão — quem controla acesso continua
// sendo `Member.role` + `Member.permissions`.
enum TradeRole {
  COORDENADOR_TRADE
  SUPERVISOR
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  permissions    String[]     @default([]) // aplicadas ao Member em afterAcceptInvitation
  tradeRole      TradeRole? // aplicado ao Member em afterAcceptInvitation
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// Link aberto de entrada na organização: qualquer pessoa com a URL (ou que leia
// o QR Code) se cadastra e vira membro, sem convite nominal por e-mail.
//
// Diferente da `Invitation`, que é para UMA pessoa e morre ao ser aceita, este
// é reutilizável — por isso o token precisa ser imprevisível e revogável, e o
// papel concedido fica travado em "member": link que circula em grupo de
// WhatsApp nunca deve dar admin. As permissões são escolhidas por quem gera o
// link (sem elas o novo membro entra sem acesso a página nenhuma).
model OrganizationJoinLink {
  id             String    @id @default(cuid())
  organizationId String
  // Vários links por org, cada um com seu conjunto de páginas liberadas — daí
  // o nome, que é como o admin distingue "Promotores" de "Coordenação" numa
  // lista de URLs todas parecidas.
  name           String
  token          String    @unique
  role           String    @default("member")
  permissions    String[]  @default([])
  // Opcional: null = vale até ser revogado.
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([organizationId])
  @@map("organization_join_links")
}

// ============================================
// CATÁLOGO ONLINE - CONFIGURAÇÕES
// ============================================

enum CatalogSortOrder {
  ASC
  DESC
  NEWEST
  OLDEST
}

// Cenário de operação do catálogo:
// - MARKETPLACE: pagamento confirmado gera apenas a venda (e-commerce de varejo)
// - KITCHEN: pagamento confirmado também cria pedidos no KDS (restaurante/food)
enum CatalogOperationMode {
  MARKETPLACE
  KITCHEN
}

enum DeliveryMethod {
  DELIVERY_HOME
  PICKUP_STORE
  ROOM_SERVICE
  DIGITAL_DELIVERY
}

enum FreightOption {
  NEGOTIATE_WHATSAPP
  NEGOTIATE_FREIGHT
  FREE_SHIPPING
  NO_SHIPPING
}

enum FreightChargeType {
  FIXED
  PER_KG
}

model CatalogSettings {
  id                      String               @id @default(cuid())
  organizationId          String               @unique
  // Visibilidade
  isActive                Boolean              @default(true)
  showPrices              Boolean              @default(true)
  showProductWithoutStock Boolean              @default(false)
  showStock               Boolean              @default(false)
  allowOrders             Boolean              @default(false)
  sortOrder               CatalogSortOrder     @default(ASC)
  // Modo de operação: MARKETPLACE (apenas venda) ou KITCHEN (envia pedidos pagos à cozinha)
  operationMode           CatalogOperationMode @default(MARKETPLACE)
  // Contato
  whatsappNumber          String?
  showWhatsapp            Boolean              @default(true)
  contactEmail            String?
  //Adress
  cep                     String?
  address                 String?
  district                String?
  number                  String?
  // SEO
  metaTitle               String?
  metaDescription         String?
  cnpj                    String?
  // Personalização
  logo                    String?
  bannerImages            String[]             @default([])
  aboutText               String?              @db.Text
  theme                   String?              @default("#00bcd4")
  //Payment
  paymentMethodSettings   PaymentMethod[]
  //Delivery
  deliveryMethods         DeliveryMethod[]
  deliverySpecialInfo     String?
  //Settings Delivery
  freightOptions          FreightOption        @default(NO_SHIPPING)
  freightChargeType       FreightChargeType    @default(FIXED)
  freightFixedValue       Decimal              @default(0) @db.Decimal(10, 2)
  freightValuePerKg       Decimal              @default(0) @db.Decimal(10, 2)
  freeShippingEnabled     Boolean              @default(false)
  freeShippingMinValue    Decimal              @default(0) @db.Decimal(10, 2)
  //Integrations
  id_meta                 String?
  pixel_meta              String?
  //Stripe
  stripeKey               String?              @map("stripe_key")
  //Asaas
  walletId                String?              @map("wallet_id")
  // Redes Sociais
  instagram               String?
  facebook                String?
  twitter                 String?
  youtube                 String?
  kwai                    String?
  tiktok                  String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("catalog_settings")
}

// ============================================
// PRODUTOS E CATEGORIAS
// ============================================

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  image          String?
  order          Int          @default(0)
  isActive       Boolean      @default(true)
  // Hierarquia (categoria pai)
  parentId       String?
  parent         Category?    @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children       Category[]   @relation("SubCategories")
  // Estrutura mercadológica: 0=Categoria 1=Sub-Categoria 2=Segmento 3=Sub-Segmento.
  // `path` é materialized path de ids ("catA/subB/segC") — resolve "todos os
  // descendentes de X" com um startsWith, sem CTE recursiva. Derivados de
  // parentId; mantidos por backfill e na escrita.
  level          Int          @default(0)
  path           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  planograms     Planogram[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentId])
  @@index([organizationId, level])
  @@index([organizationId, path])
  @@map("categories")
}

enum ProductUnit {
  UN // Unidade
  KG // Quilograma
  G // Grama
  L // Litro
  ML // Mililitro
  M // Metro
  M2 // Metro quadrado
  M3 // Metro cúbico
  CX // Caixa
  PC // Peça
  PAR // Par
  DZ // Dúzia
}

model Product {
  id               String          @id @default(cuid())
  organizationId   String
  categoryId       String?
  // Informações básicas
  name             String
  slug             String
  description      String?         @db.Text
  sku              String? // Código interno
  barcode          String? // Código de barras
  // Preços
  costPrice        Decimal         @default(0) @db.Decimal(10, 2)
  salePrice        Decimal         @db.Decimal(10, 2)
  promotionalPrice Decimal?        @db.Decimal(10, 2)
  // Estoque
  unit             ProductUnit     @default(UN)
  currentStock     Decimal         @default(0) @db.Decimal(10, 3)
  minStock         Decimal         @default(0) @db.Decimal(10, 3)
  maxStock         Decimal?        @db.Decimal(10, 3)
  // Imagens
  images           String[] // Array de URLs
  // default "" para viabilizar gravação em massa (createMany/COPY na importação):
  // sem isso qualquer linha de planilha sem imagem quebra o lote inteiro.
  thumbnail        String          @default("") // chave R2 da thumbnail
  // Dimensões e peso — LEGADO: sem unidade declarada em nenhuma camada (schema,
  // formulário ou importador), então os dados existentes misturam cm e m.
  // NÃO usar em planograma; usar os campos *Mm abaixo.
  weight           Decimal?        @db.Decimal(10, 3)
  length           Decimal?        @db.Decimal(10, 2)
  width            Decimal?        @db.Decimal(10, 2)
  height           Decimal?        @db.Decimal(10, 2)
  // Dimensões para planograma — milímetro INTEIRO de propósito: somar dezenas de
  // larguras em float acumula deriva; em mm é exato, e casa com a precisão de
  // uma trena. Medem a UNIDADE DE VENDA (o que fica na frente da gôndola).
  widthMm          Int?
  heightMm         Int?
  depthMm          Int?
  grossWeightG     Int?
  // Embalagem secundária (a caixa) — necessária para "prateleira de caixaria".
  packQty          Int?
  packWidthMm      Int?
  packHeightMm     Int?
  packDepthMm      Int?
  brandId          String?
  ncm              String?
  // Controle
  isActive         Boolean         @default(true)
  isFeatured       Boolean         @default(false)
  trackStock       Boolean         @default(true)
  // KDS - tempo médio de preparo (min) usado no painel da cozinha
  prepTimeMinutes  Int?
  // Timestamps
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String
  supplierId       String?
  // Relações
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier         Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  brand            Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdBy        User            @relation("CreatedProducts", fields: [createdById], references: [id])
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]
  stockMovements   StockMovement[]
  kitchenOrders    KitchenOrder[]
  planogramItems   PlanogramItem[]
  favorites        Favorite[]
  storeProducts    StoreProduct[]
  batches          ProductBatch[]

  @@unique([organizationId, slug])
  // @@unique([organizationId, sku])
  // Chave natural do produto: é ela que viabiliza `ON CONFLICT DO UPDATE` na
  // importação massiva — sem isso, reimportar a planilha duplica tudo. Também
  // serve de índice para a busca por EAN no seletor do planograma.
  // NULL não conflita em UNIQUE no Postgres, então produto sem EAN fica livre;
  // string vazia CONFLITA, por isso a migration normaliza "" para NULL.
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, brandId])
  @@index([isActive])
  @@index([supplierId])
  @@map("products")
}

// ============================================
// ESTOQUE - MOVIMENTAÇÕES
// ============================================

enum MovementType {
  ENTRADA // Entrada manual
  SAIDA // Saída manual
  VENDA // Saída por venda
  COMPRA // Entrada por compra
  DEVOLUCAO // Devolução de venda
  AJUSTE // Ajuste de inventário
  TRANSFERENCIA // Transferência entre locais
  PERDA // Perda/Quebra
}

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  productId      String
  type           MovementType
  quantity       Decimal      @db.Decimal(10, 3)
  // Estoque antes e depois (para auditoria)
  previousStock  Decimal      @db.Decimal(10, 3)
  newStock       Decimal      @db.Decimal(10, 3)
  // Custo unitário no momento da movimentação
  unitCost       Decimal?     @db.Decimal(10, 2)
  // Referências
  saleId         String?
  purchaseId     String?
  // Observações
  notes          String?      @db.Text
  // Timestamps e usuário
  createdAt      DateTime     @default(now())
  createdById    String
  // Relações
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedStockMovements", fields: [createdById], references: [id])
  sale           Sale?        @relation(fields: [saleId], references: [id])
  purchase       Purchase?    @relation(fields: [purchaseId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([saleId])
  @@index([purchaseId])
  @@map("stock_movements")
}

// ============================================
// CLIENTES
// ============================================

enum PersonType {
  FISICA // Pessoa Física
  JURIDICA // Pessoa Jurídica
}

model Customer {
  id              String       @id @default(cuid())
  organizationId  String
  // Identificação
  name            String
  personType      PersonType   @default(FISICA)
  document        String? // CPF ou CNPJ
  email           String? // opcional; quando presente, é único por organização
  phone           String?
  // Endereço
  address         String?
  addressNumber   String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  zipCode         String?
  // Informações adicionais
  notes           String?      @db.Text
  isActive        Boolean      @default(true)
  //Assas
  asaasCustomerId String?      @map("asaas_customer_id")
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  // Relações
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales           Sale[]
  suppliers       Supplier[]
  userCatalog     CatalogUser? @relation(fields: [clientId], references: [id])
  clientId        String?      @unique

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([document])
  @@index([email])
  @@map("customers")
}

// ============================================
// FORNECEDORES
// ============================================

model Supplier {
  id                String                     @id @default(cuid())
  organizationId    String
  // Identificação
  name              String
  tradeName         String?
  personType        PersonType                 @default(JURIDICA)
  document          String? // CPF ou CNPJ
  email             String?
  phone             String?
  // Endereço
  address           String?
  addressNumber     String?
  complement        String?
  neighborhood      String?
  city              String?
  state             String?
  zipCode           String?
  // Informações adicionais
  logo              String?
  // Imagem R2 do "código de ação" desta indústria, carimbada na foto do promotor.
  actionCodeImage   String?
  contactPerson     String?
  notes             String?                    @db.Text
  isActive          Boolean                    @default(true)
  // Timestamps
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  // Relações
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases         Purchase[]
  products          Product[]
  customerId        String?
  customer          Customer?                  @relation(fields: [customerId], references: [id])
  // Trade Marketing: fornecedor atua como "Indústria"
  brands            Brand[]
  mapObjects        MapObject[]
  pdvPhotos         PdvPhoto[]
  books             Book[]
  bookTemplates     BookTemplate[]
  bookPageTemplates BookPageTemplate[]
  negotiations      SpaceNegotiation[]
  promoterLinks     PromoterSupplier[]
  promoterFavorites PromoterFavoriteSupplier[]
  distributorLinks  DistributorIndustry[]
  calendarEvents    CalendarEventSupplier[]

  @@index([organizationId])
  @@index([document])
  @@map("suppliers")
}

model CatalogUser {
  id             String @id @default(cuid())
  organizationId String

  email        String
  passwordHash String
  name         String

  // Dados coletados no checkout
  phone   String?
  address String?
  city    String?
  state   String?
  zipCode String?

  // Stripe
  stripeCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("catalog_users")
}

// ============================================
// VENDAS
// ============================================

enum SaleStatus {
  DRAFT // Rascunho
  CONFIRMED // Confirmado
  PROCESSING // Em processamento
  COMPLETED // Concluído
  CANCELLED // Cancelado
}

enum PaymentMethod {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  BOLETO
  TRANSFERENCIA
  OUTROS
}

model Sale {
  id             String          @id @default(cuid())
  organizationId String
  customerId     String?
  // Numeração
  invoiceNumber  String? // Número da nota fiscal
  saleNumber     Int // Número sequencial da venda
  // Status
  status         SaleStatus      @default(DRAFT)
  // Valores
  subtotal       Decimal         @db.Decimal(10, 2)
  discount       Decimal         @default(0) @db.Decimal(10, 2)
  shipping       Decimal         @default(0) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  // Pagamento
  paymentMethod  PaymentMethod?
  paidAt         DateTime?
  // Observações
  notes          String?         @db.Text
  // Timestamps
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdById    String?
  // Relações
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("CreatedSales", fields: [createdById], references: [id])
  items          SaleItem[]
  stockMovements StockMovement[]
  transactions   Transaction[]

  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  // Dados do produto no momento da venda
  productName String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  // Relações
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ============================================
// COZINHA (KDS - Kitchen Display System)
// ============================================

// Colunas personalizáveis do kanban (uma org tem N colunas).
// Substitui o antigo enum KitchenOrderStatus: o "status" passa a ser a coluna.
model KitchenColumn {
  id             String         @id @default(cuid())
  organizationId String
  name           String // Nomenclatura editável: "Em Preparo", "Na Brasa"...
  color          String         @default("#64748B") // Cor de identificação (hex)
  position       Int // Ordem no board (0,1,2...)
  wipLimit       Int? // Limite WIP (null = sem limite)
  isActive       Boolean        @default(true) // Visível/ativa no board
  description    String? // Texto auxiliar (opcional)
  icon           String? // Ícone lucide (ex "ChefHat") ou emoji
  isInitial      Boolean        @default(false) // Coluna de entrada: novos pedidos caem aqui
  showOnTv       Boolean        @default(false) // Alimenta o painel da TV
  isFinal        Boolean        @default(false) // Estado terminal: auto-some / fora da TV
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  // Relações
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         KitchenOrder[]

  @@index([organizationId, position])
  @@index([organizationId, isActive])
  @@map("kitchen_columns")
}

model KitchenOrder {
  id               String              @id @default(cuid())
  organizationId   String
  columnId         String // Coluna atual (substitui o antigo enum status)
  // Pedido
  tableNumber      String // Texto livre: "18", "Balcão 3"
  dishName         String // Nome do prato (texto livre)
  productId        String? // Vínculo opcional ao catálogo
  estimatedMinutes Int? // Snapshot do tempo de preparo na criação
  position         Int                 @default(0) // Ordem do card dentro da coluna
  notes            String?
  // Atendente (Collaborator) responsável pelo pedido
  attendantId      String? // FK opcional para sobreviver ao soft-delete do colaborador
  attendantName    String? // Snapshot do nome no momento do pedido
  attendantPhoto   String? // Snapshot da foto no momento do pedido
  // Timestamps
  createdAt        DateTime            @default(now())
  columnEnteredAt  DateTime            @default(now()) // Quando entrou na coluna atual (tempo decorrido + auto-hide)
  archivedAt       DateTime? // Quando foi arquivado; null = ativo no board
  createdById      String?
  // Relações
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  column           KitchenColumn       @relation(fields: [columnId], references: [id], onDelete: Restrict)
  product          Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("CreatedKitchenOrders", fields: [createdById], references: [id])
  attendant        Collaborator?       @relation(fields: [attendantId], references: [id], onDelete: SetNull)
  events           KitchenOrderEvent[]

  @@index([organizationId, columnId])
  @@index([columnId, position])
  @@index([createdAt])
  @@index([organizationId, archivedAt])
  @@map("kitchen_orders")
}

model Collaborator {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  role           String // Função/cargo (ex: "Garçom", "Caixa")
  photoUrl       String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitchenOrders  KitchenOrder[]
  kitchenEvents  KitchenOrderEvent[]

  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("collaborators")
}

enum KitchenOrderEventType {
  CREATED // Pedido criado
  MOVED // Movido entre colunas intermediárias
  READY // Marcado como pronto (entrou em coluna showOnTv)
  DELIVERED // Entregue ao cliente (entrou em coluna isFinal)
  ARCHIVED // Arquivado (sai do board)
  RESTORED // Restaurado do arquivo
}

enum KitchenOrderActorType {
  USER // Usuário Better Auth (admin/cozinha)
  WAITER // Colaborador via kiosk público
  SYSTEM // Ação automática
}

model KitchenOrderEvent {
  id                  String                @id @default(cuid())
  organizationId      String
  orderId             String? // null se o pedido for removido depois
  type                KitchenOrderEventType
  // Snapshots do pedido (para o histórico continuar legível mesmo após edições)
  tableNumber         String
  dishName            String
  fromColumnId        String?
  fromColumnName      String?
  toColumnId          String?
  toColumnName        String?
  attendantId         String?
  attendantName       String?
  attendantPhoto      String?
  // Autor da ação
  actorType           KitchenOrderActorType
  actorUserId         String?
  actorCollaboratorId String?
  actorName           String
  actorPhotoUrl       String?
  createdAt           DateTime              @default(now())

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order             KitchenOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorUser         User?         @relation("KitchenEventsByUser", fields: [actorUserId], references: [id])
  actorCollaborator Collaborator? @relation(fields: [actorCollaboratorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([orderId, createdAt])
  @@map("kitchen_order_events")
}

// ============================================
// COMPRAS
// ============================================

enum PurchaseStatus {
  PENDING // Pendente
  CONFIRMED // Confirmado
  RECEIVED // Recebido
  CANCELLED // Cancelado
}

model Purchase {
  id             String          @id @default(cuid())
  organizationId String
  supplierId     String?
  // Numeração
  purchaseNumber Int // Número sequencial
  invoiceNumber  String? // Número da NF do fornecedor
  // Status
  status         PurchaseStatus  @default(PENDING)
  // Valores
  subtotal       Decimal         @db.Decimal(10, 2)
  discount       Decimal         @default(0) @db.Decimal(10, 2)
  shipping       Decimal         @default(0) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  // Datas
  orderDate      DateTime        @default(now())
  expectedDate   DateTime?
  receivedDate   DateTime?
  // Observações
  notes          String?         @db.Text
  // Timestamps
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String
  // Relações
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("CreatedPurchases", fields: [createdById], references: [id])
  items          PurchaseItem[]
  stockMovements StockMovement[]
  transactions   Transaction[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String
  // Dados
  productName String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  // Relações
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ============================================
// FINANCEIRO
// ============================================

enum AccountType {
  BANCO // Conta bancária
  CAIXA // Caixa físico
  POUPANCA // Poupança
  INVESTIMENTO // Investimento
  OUTROS // Outros
}

model FinancialAccount {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  type           AccountType   @default(CAIXA)
  bank           String?
  agency         String?
  account        String?
  initialBalance Decimal       @default(0) @db.Decimal(10, 2)
  currentBalance Decimal       @default(0) @db.Decimal(10, 2)
  isActive       Boolean       @default(true)
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([organizationId])
  @@index([isActive])
  @@map("financial_accounts")
}

enum TransactionType {
  RECEITA // Entrada
  DESPESA // Saída
}

enum TransactionCategory {
  // Receitas
  VENDAS
  SERVICOS
  OUTROS_RECEITAS
  // Despesas
  FORNECEDORES
  SALARIOS
  ALUGUEL
  ENERGIA
  AGUA
  INTERNET
  TELEFONE
  IMPOSTOS
  MARKETING
  MANUTENCAO
  OUTROS_DESPESAS
}

enum TransactionStatus {
  PENDING // Pendente
  PAID // Pago
  OVERDUE // Atrasado
  CANCELLED // Cancelado
}

model Transaction {
  id             String              @id @default(cuid())
  organizationId String
  accountId      String
  type           TransactionType
  category       TransactionCategory
  status         TransactionStatus   @default(PENDING)
  description    String
  amount         Decimal             @db.Decimal(10, 2)
  // Datas
  dueDate        DateTime
  paidAt         DateTime?
  // Referências
  saleId         String?
  purchaseId     String?
  // Recorrência
  isRecurring    Boolean             @default(false)
  recurringDay   Int? // Dia do mês
  // Observações
  notes          String?             @db.Text
  attachment     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  // Relações
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        FinancialAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sale           Sale?               @relation(fields: [saleId], references: [id])
  purchase       Purchase?           @relation(fields: [purchaseId], references: [id])

  @@index([organizationId])
  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([saleId])
  @@index([purchaseId])
  @@map("transactions")
}

// ============================================
// INTEGRAÇÃO NASA (Server-to-Server)
// ============================================

model NasaIntegrationConsent {
  id          String    @id @default(cuid())
  code        String    @unique
  nerpOrgId   String
  userId      String
  scopes      String[]
  redirectUri String
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  organization Organization @relation(fields: [nerpOrgId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([expiresAt])
  @@index([nerpOrgId])
  @@map("nasa_integration_consents")
}

model NasaIntegrationKey {
  id               String    @id @default(cuid())
  organizationId   String
  apiKey           String    @unique
  secretCiphertext String
  scopes           String[]
  consentByUserId  String
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([apiKey])
  @@map("nasa_integration_keys")
}

// ============================================
// SYNC DE AUTH NERP → NASA (outbox)
// ============================================
// O NERP não tem Inngest. Os hooks do better-auth só GRAVAM aqui
// (fire-and-forget); um processador (endpoint/cron) lê os pendentes, chama o
// cliente outbound e marca `deliveredAt` ou agenda retry com backoff.

model SyncOutbox {
  id            String    @id @default(cuid())
  type          String // "user" | "account" | "org" | "member"
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([deliveredAt, nextAttemptAt])
  @@map("sync_outbox")
}

// ============================================
// Importação de produtos via planilha (CSV/XLSX)
// ============================================
// Cada importação em massa cria uma linha aqui. O arquivo bruto vai pro S3
// (`fileKey`); a função Inngest `productImportProcess` lê este registro, baixa o
// arquivo, processa em lotes e atualiza os contadores/erros para a UI fazer polling.

enum ProductImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ProductImport {
  id             String              @id @default(cuid())
  organizationId String
  createdById    String
  fileKey        String // chave do objeto no S3
  fileName       String
  mapping        Json // { campoProduto: nomeColunaArquivo }
  status         ProductImportStatus @default(PENDING)
  totalRows      Int                 @default(0)
  processedRows  Int                 @default(0)
  createdRows    Int                 @default(0)
  failedRows     Int                 @default(0)
  errors         Json                @default("[]") // [{ row, message }]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  completedAt    DateTime?

  @@index([organizationId, status])
  @@map("product_imports")
}

// ============================================
// Importação de fornecedores via planilha (CSV/XLSX)
// ============================================
// Espelha ProductImport. O arquivo bruto vai pro S3 (`fileKey`); a função Inngest
// `supplierImportProcess` lê este registro, baixa o arquivo, processa linha a linha
// (pulando documentos já cadastrados) e atualiza os contadores/erros para a UI.

enum SupplierImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model SupplierImport {
  id             String               @id @default(cuid())
  organizationId String
  createdById    String
  fileKey        String // chave do objeto no S3
  fileName       String
  mapping        Json // { campoFornecedor: nomeColunaArquivo }
  status         SupplierImportStatus @default(PENDING)
  totalRows      Int                  @default(0)
  processedRows  Int                  @default(0)
  createdRows    Int                  @default(0)
  skippedRows    Int                  @default(0) // duplicados (mesmo documento) pulados
  failedRows     Int                  @default(0)
  errors         Json                 @default("[]") // [{ row, message }]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  completedAt    DateTime?

  @@index([organizationId, status])
  @@map("supplier_imports")
}

enum CustomerImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CustomerImport {
  id             String               @id @default(cuid())
  organizationId String
  createdById    String
  fileKey        String // chave do objeto no S3
  fileName       String
  mapping        Json // { campoCliente: nomeColunaArquivo }
  status         CustomerImportStatus @default(PENDING)
  totalRows      Int                  @default(0)
  processedRows  Int                  @default(0)
  createdRows    Int                  @default(0)
  skippedRows    Int                  @default(0) // duplicados (mesmo email) pulados
  failedRows     Int                  @default(0)
  errors         Json                 @default("[]") // [{ row, message }]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  completedAt    DateTime?

  @@index([organizationId, status])
  @@map("customer_imports")
}

model PromotionalCatalog {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  config         Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("promotional_catalogs")
}

// ============================================
// RANKING DE EQUIPES — METAS DE VENDA
// Metas importadas de planilha (Winthor/Totvs); vendido calculado
// automaticamente de Sale quando a entry está vinculada a um Member.
// ============================================

enum SalesGoalPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum SalesGoalEntryKind {
  SELLER // vendedor real (código de vendedor no Winthor)
  BUCKET // linha não-pessoa: treinamento, checkout, etc.
}

enum SalesGoalRankingTheme {
  GAMING
  LIGHT
  DARK
  GALAXY
}

model SalesGoalPeriod {
  id                String              @id @default(cuid())
  organizationId    String
  periodType        SalesGoalPeriodType
  periodStart       DateTime
  periodEnd         DateTime
  label             String?
  sourceFileName    String?
  importedAt        DateTime            @default(now())
  importedByUserId  String?
  // Meta geral do mês (org inteira), digitada à mão — independente da soma das
  // metas das equipes. Null = comportamento antigo (soma das equipes).
  overallGoalAmount Decimal?            @db.Decimal(15, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     SalesGoalBranch[]

  @@unique([organizationId, periodType, periodStart])
  @@index([organizationId])
  @@map("sales_goal_periods")
}

model SalesGoalBranch {
  id                 String   @id @default(cuid())
  periodId           String
  name               String
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  // Meta geral da equipe, digitada à mão — independente da soma das metas dos
  // vendedores dela. Null = comportamento antigo (soma das entries).
  goalAmountOverride Decimal? @db.Decimal(15, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  period  SalesGoalPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  entries SalesGoalEntry[]

  @@unique([periodId, name])
  @@index([periodId])
  @@map("sales_goal_branches")
}

model SalesGoalEntry {
  id               String             @id @default(cuid())
  branchId         String
  externalCode     String
  goalName         String
  sellerName       String
  entryKind        SalesGoalEntryKind @default(SELLER)
  goalAmount       Decimal            @db.Decimal(15, 2)
  achievedAmount   Decimal?           @db.Decimal(15, 2) // vendido manual; com memberId vinculado só vale se achievedIsManual
  // Override: entry vinculada a um Member tem o vendido calculado das vendas,
  // salvo quando o admin digita um valor à mão (vendas fora do NERP, outra
  // empresa…). Sem a flag, valores manuais latentes de antes do vínculo
  // voltariam a aparecer sozinhos.
  achievedIsManual Boolean            @default(false)
  photoUrl         String? // chave S3 da foto do participante; construída em URL no client
  memberId         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  branch SalesGoalBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([branchId, externalCode])
  @@index([branchId])
  @@index([memberId])
  @@map("sales_goal_entries")
}

// Configuração de exibição do Ranking de Equipes (1 por organização)
model SalesGoalRankingSettings {
  id                String                @id @default(cuid())
  organizationId    String                @unique
  displayName       String                @default("Ranking de Equipes")
  theme             SalesGoalRankingTheme @default(GAMING)
  activePeriodTypes SalesGoalPeriodType[]
  soundEnabled      Boolean               @default(true)
  scoreSoundUrl     String?
  overtakeSoundUrl  String?
  victorySoundUrl   String?
  soundVolume       Float                 @default(0.6)
  prizes            Json                  @default("[]") // [{ position, label, imageUrl? }]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sales_goal_ranking_settings")
}

// ============================================
// TRADE MARKETING — LOJAS, MAPA (PLANTA BAIXA), PDV E BOOK
// ============================================

enum MapObjectType {
  WALL
  AISLE
  SECTOR
  GONDOLA
  ISLAND
  CHECKOUT
  ENTRANCE
  EXIT
  DEPOSIT
  RESTRICTED_AREA
  PIN
  TEXT
}

enum MapShapeKind {
  RECT
  POLYGON
  POLYLINE
  POINT
}

enum MapAnnotationType {
  PIN
  COMMENT
  ALERT
  PENDING
}

enum BookStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

// Aprovação da foto de uma página do book pela coordenadora.
enum BookItemApproval {
  PENDING
  APPROVED
  REJECTED
}

enum TradeCatalogStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

// Padrões de disposição das fotos de um PdvPhoto (2 ou 3 fotos).
// null = grade automática (1 foto = tela cheia, 4 fotos = grade 2x2).
enum PdvPhotoLayoutPattern {
  PATTERN_1 // 3 fotos: 1 vertical à esquerda + 2 horizontais empilhadas à direita
  PATTERN_2 // 3 fotos: 2 horizontais empilhadas à esquerda + 1 vertical à direita
  PATTERN_3 // 2 fotos: 2 verticais lado a lado
  PATTERN_4 // 2 fotos: 2 horizontais empilhadas
}

// Estado de execução de um espaço negociável no mapa. Define a cor do elemento.
enum MapSpaceState {
  LIVRE // 🟡 espaço disponível
  EXECUTADO // 🟢 ação executada no espaço
  PENDENTE // 🔴 execução pendente
}

enum NegotiationStatus {
  RASCUNHO
  PROPOSTA
  FECHADA
  CANCELADA
}

// Biblioteca Nacional de Espaços Comerciais — classificação do espaço p/
// comparar e precificar entre lojas/redes. Nullable e sem default: espaço não
// classificado precisa continuar "não classificado", não virar BRONZE/BAIXO
// silenciosamente (mentiria pro heatmap e pra fórmula de preço).
enum SpaceTier {
  PREMIUM
  OURO
  PRATA
  BRONZE
}

enum SpaceFlowLevel {
  MUITO_ALTO
  ALTO
  MEDIO
  BAIXO
}

enum SpaceVisibility {
  EXCELENTE
  BOA
  REGULAR
}

/// Procedência da coordenada da loja. A ordem reflete a preferência: a posição
/// tirada das fotos do promotor no local vale mais que qualquer geocodificação
/// de endereço em texto livre.
enum StoreGeoSource {
  FOTO
  MANUAL
  IMPORTED
  GEOCODED
  OSM
}

enum StoreGeoStatus {
  PENDING
  QUEUED
  OK
  NOT_FOUND
  FAILED
}

model Store {
  id                    String                        @id @default(cuid())
  organizationId        String
  name                  String
  /// URL pública legível (`/tradegram/<slug>`). Único GLOBALMENTE, porque o
  /// segmento é compartilhado com o slug de organização. Anulável: loja de
  /// empresa privada não tem página e NULL não colide com NULL no Postgres.
  slug                  String?                       @unique
  code                  String?
  managerName           String? // Gerente da loja
  address               String?
  city                  String?
  state                 String?
  /// CEP, só dígitos.
  postcode              String?
  notes                 String?                       @db.Text
  isActive              Boolean                       @default(true)
  coverImageKey         String? // chave R2 da foto de fachada — vitrine PlanoGram
  // Métricas manuais p/ o Catálogo PDV (custo do m²) e a Biblioteca Nacional.
  // Nenhum contador automático existe — ponte ERP↔mapa é fora de escopo.
  areaM2                Float?
  monthlyCost           Decimal?                      @db.Decimal(12, 2)
  customersPerDay       Int?
  // Posição no mapa. `geoSource` é o que impede a próxima rodada automática de
  // sobrescrever um pino ajustado à mão.
  latitude              Float?
  longitude             Float?
  geoSource             StoreGeoSource?
  geoStatus             StoreGeoStatus                @default(PENDING)
  /// Quantas fotos sustentam a posição — vira o texto de confiança na tela e
  /// evita que uma foto solta com GPS ruim mande no pino.
  geoSampleCount        Int                           @default(0)
  /// `addresstype` do Nominatim. Separa pino de rua de centroide de cidade, que
  /// o provedor devolve sem erro nenhum.
  geoPrecision          String?
  /// Endereço normalizado já consultado — torna "não pergunte duas vezes"
  /// verificável, como a política do Nominatim exige.
  geoQuery              String?
  geoUpdatedAt          DateTime?
  geoError              String?
  /// Identidade do ponto no OpenStreetMap ("node/123"). É o que torna a
  /// importação idempotente: varrer a mesma área de novo não duplica cliente.
  osmId                 String?
  /// O MESMO ponto físico no catálogo nacional. É identidade compartilhada, não
  /// fronteira de inquilino: todo query continua filtrando por
  /// `organizationId`. Sem ele, duas organizações com a mesma loja produzem
  /// dois pinos no mapa público.
  directoryStoreId      String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  directoryStore        DirectoryStore?               @relation(fields: [directoryStoreId], references: [id], onDelete: SetNull)
  floorPlans            FloorPlan[]
  pdvPhotos             PdvPhoto[]
  mediaTypePrices       MediaTypePrice[]
  promoterLinks         PromoterStore[]
  promoterFavorites     PromoterFavoriteStore[]
  spaceInterests        SpaceInterest[]
  distributorLinks      StoreDistributor[]
  storeProducts         StoreProduct[]
  batches               ProductBatch[]
  calendarEvents        CalendarEventStore[]
  calendarChecklistDone CalendarChecklistCompletion[]
  routeStops            PromoterRouteStop[]

  @@unique([organizationId, osmId])
  @@index([organizationId])
  @@index([organizationId, geoStatus])
  @@index([osmId])
  @@index([directoryStoreId])
  @@index([latitude, longitude])
  @@map("stores")
}

enum StoreImportTarget {
  ORGANIZACAO // vira cliente desta organização
  CATALOGO // vira ponto do catálogo nacional, sem dono
}

model StoreImport {
  id             String            @id @default(cuid())
  organizationId String
  createdById    String
  fileKey        String // chave do objeto no S3
  fileName       String
  mapping        Json // { campoLoja: nomeColunaArquivo }
  /// Para onde as linhas vão: a carteira desta organização, ou o catálogo
  /// nacional de PDVs (restrito à administração do TradeGram).
  target         StoreImportTarget @default(ORGANIZACAO)
  status         StoreImportStatus @default(PENDING)
  totalRows      Int               @default(0)
  processedRows  Int               @default(0)
  createdRows    Int               @default(0)
  skippedRows    Int               @default(0) // duplicados pulados (código, ou nome+cidade)
  failedRows     Int               @default(0)
  errors         Json              @default("[]") // [{ row, message }]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  @@index([organizationId, status])
  @@map("store_imports")
}

enum StoreImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Vínculo promotor → indústria: as indústrias que o promotor representa.
model PromoterSupplier {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  supplierId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([memberId, supplierId])
  @@index([organizationId])
  @@index([supplierId])
  @@map("promoter_suppliers")
}

// Vínculo promotor → loja: as lojas que o promotor cobre.
model PromoterStore {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  storeId        String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([memberId, storeId])
  @@index([organizationId])
  @@index([storeId])
  @@map("promoter_stores")
}

// Favoritos do promotor. NÃO confundir com PromoterStore/PromoterSupplier: o
// vínculo é permissão (quem o admin autorizou), o favorito é conveniência (o
// que o promotor marcou para subir ao topo da lista). Promotor tem rota fixa de
// marcas específicas, então favoritar poupa a busca a cada captura.
model PromoterFavoriteStore {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  storeId        String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([memberId, storeId])
  @@index([organizationId])
  @@index([storeId])
  @@map("promoter_favorite_stores")
}

model PromoterFavoriteSupplier {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  supplierId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([memberId, supplierId])
  @@index([organizationId])
  @@index([supplierId])
  @@map("promoter_favorite_suppliers")
}

// Distribuidor: intermediário logístico entre indústria e loja. A indústria nem
// sempre tem vínculo direto com a loja — usa o distribuidor. É a ponte do grafo
// de autorização da Fase 2 (indústria→distribuidor→loja).
model Distributor {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  document       String? // CNPJ
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  logo           String?
  notes          String?               @db.Text
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industries     DistributorIndustry[]
  stores         StoreDistributor[]
  promoterLinks  PromoterDistributor[]

  @@index([organizationId])
  @@map("distributors")
}

// Distribuidor ↔ indústria: quais indústrias o distribuidor representa.
model DistributorIndustry {
  id             String       @id @default(cuid())
  organizationId String
  distributorId  String
  supplierId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  distributor    Distributor  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([distributorId, supplierId])
  @@index([organizationId])
  @@index([supplierId])
  @@map("distributor_industries")
}

// Distribuidor ↔ loja: quais lojas o distribuidor atende.
model StoreDistributor {
  id             String       @id @default(cuid())
  organizationId String
  storeId        String
  distributorId  String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  distributor    Distributor  @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([storeId, distributorId])
  @@index([organizationId])
  @@index([distributorId])
  @@map("store_distributors")
}

// Promotor ↔ distribuidor: os distribuidores que o promotor representa. Junto
// com as junções acima, autoriza o promotor a atuar numa loja via distribuidor.
model PromoterDistributor {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  distributorId  String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  distributor    Distributor  @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([memberId, distributorId])
  @@index([organizationId])
  @@index([distributorId])
  @@map("promoter_distributors")
}

// Diretório global de empresas (acima de org). Cascas pré-cadastradas por CNPJ
// (supermercados/indústrias/distribuidores) que dão lastro à busca cross-org
// desde o dia 1. Enquanto não reivindicada (claimedByOrgId nulo), é só uma
// vitrine pública não-editável; o dono reivindica e passa a administrar.
model DirectoryCompany {
  id             String           @id @default(cuid())
  type           CompanyType
  name           String
  tradeName      String?
  document       String?          @unique // CNPJ — dedup global
  city           String?
  state          String?
  logoKey        String?
  website        String?
  source         CompanySource    @default(USUARIO)
  claimedByOrgId String?
  claimedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  claimedByOrg   Organization?    @relation("ClaimedCompanies", fields: [claimedByOrgId], references: [id], onDelete: SetNull)
  claims         CompanyClaim[]
  stores         DirectoryStore[]

  @@index([type])
  @@index([claimedByOrgId])
  @@map("directory_companies")
}

// Reivindicação de uma empresa do diretório por uma org. APROVADA na hora quando
// a empresa está livre (first-claim-wins com evidência registrada); CONTESTADA
// quando já tem dono (fica pra resolução futura).
/// Ponto de venda conhecido, GLOBAL — não pertence a organização nenhuma.
///
/// A rede existe no mapa independente de alguém tê-la como cliente: é o que
/// permite qualquer empresa abrir o TradeGram e já ver o varejo da sua praça,
/// em vez de um mapa vazio à espera do primeiro cadastro. Virar cliente é uma
/// cópia disto para `Store`, com o `osmId` ligando os dois.
model DirectoryStore {
  id          String              @id @default(cuid())
  companyId   String?
  name        String
  /// Identidade do ponto no OpenStreetMap — dedup global.
  osmId       String?             @unique
  /// CNPJ do ESTABELECIMENTO, só dígitos. Matriz e filial têm CNPJs distintos,
  /// então ele identifica a loja física — a chave mais forte que existe aqui.
  document    String?             @unique
  /// Opcional: a lista de PDVs entra com endereço e sem coordenada, e quem fixa
  /// o pino é a primeira foto do promotor. Ponto sem coordenada existe, é
  /// buscável e contável — só não vai ao mapa.
  latitude    Float?
  longitude   Float?
  address     String?
  suburb      String?
  city        String?
  state       String?
  /// CEP, só dígitos. Completa o endereço e é o caminho barato para virar
  /// coordenada: base de CEP brasileira não tem o limite do Nominatim.
  postcode    String?
  /// Sobrepõe a logo da rede neste ponto. Existe porque `companyId` é anulável:
  /// ponto sem rede não teria onde guardar logo nenhuma.
  logoKey     String?
  source      CompanySource       @default(SEED)
  /// Fila de revisão do super-admin: `null` = ainda não conferido. O ponto que
  /// nasce da foto do promotor entra no mapa na hora e é auditado depois.
  reviewedAt  DateTime?
  /// Qual organização originou o ponto. Auditoria — NUNCA sai em payload
  /// público, porque revelaria onde cada empresa opera.
  sourceOrgId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  company     DirectoryCompany?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  routeStops  PromoterRouteStop[]
  stores      Store[]

  @@index([companyId])
  @@index([reviewedAt])
  @@index([state, city])
  @@index([latitude, longitude])
  @@map("directory_stores")
}

/// Rota do promotor: a ordem em que ele planeja visitar as lojas.
///
/// Uma por promotor (`memberId @unique`) — dia da semana e data ficam para
/// depois, sobre esta base. Não confundir com `PromoterStore`, que é PERMISSÃO
/// dada pela coordenação: a rota é escolha de quem anda na rua.
model PromoterRoute {
  id             String              @id @default(cuid())
  organizationId String
  memberId       String              @unique
  name           String              @default("Minha rota")
  /// Quando a ordem foi sugerida pela última vez. Só informativo.
  optimizedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  stops          PromoterRouteStop[]

  @@index([organizationId])
  @@map("promoter_routes")
}

/// Parada da rota. Aponta para um cliente da organização OU para um ponto
/// global do catálogo — exatamente um dos dois, garantido por CHECK no banco,
/// que o Prisma não sabe expressar.
model PromoterRouteStop {
  id               String          @id @default(cuid())
  /// Desnormalizado de propósito: é o filtro de inquilino de TODA query aqui.
  /// A fronteira vem da rota, nunca do alvo — o alvo pode ser uma linha global.
  organizationId   String
  routeId          String
  position         Int
  storeId          String?
  directoryStoreId String?
  /// Cópia da posição e do nome no momento em que a parada entrou. Desacopla a
  /// rota de uma linha que não pertence a esta organização.
  latitude         Float
  longitude        Float
  name             String
  createdAt        DateTime        @default(now())
  route            PromoterRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  store            Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  directoryStore   DirectoryStore? @relation(fields: [directoryStoreId], references: [id], onDelete: Cascade)

  /// Funcionam porque o Postgres trata NULL como distinto: muitas paradas de
  /// catálogo convivem com `storeId` nulo, mas a mesma loja duas vezes é barrada.
  @@unique([routeId, storeId])
  @@unique([routeId, directoryStoreId])
  @@index([routeId, position])
  @@index([organizationId])
  @@map("promoter_route_stops")
}

model CompanyClaim {
  id                String             @id @default(cuid())
  companyId         String
  organizationId    String
  requestedByUserId String
  status            CompanyClaimStatus @default(APROVADA)
  claimantRole      String?
  contactEmail      String?
  document          String?
  notes             String?            @db.Text
  createdAt         DateTime           @default(now())
  resolvedAt        DateTime?
  company           DirectoryCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organization      Organization       @relation("OrgCompanyClaims", fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy       User               @relation("UserCompanyClaims", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([organizationId])
  @@map("company_claims")
}

enum CompanyType {
  SUPERMERCADO
  INDUSTRIA
  DISTRIBUIDOR
}

/// O que a organização é dentro do TradeGram. Semeia os módulos do menu na
/// criação — NÃO é uma camada de permissão: já existem quatro (papel,
/// permissões, módulos da org, módulos do usuário), e uma quinta tornaria "por
/// que não vejo X?" impossível de responder.
enum OrgSegment {
  VAREJO
  INDUSTRIA
  DISTRIBUIDOR
  AGENCIA
  OUTRO
}

enum CompanySource {
  SEED // semeada pelo sistema
  IMPORTACAO // importada em lote
  USUARIO // adicionada por um usuário
  PROMOTOR // nasceu da foto de um promotor em campo
}

enum CompanyClaimStatus {
  APROVADA
  PENDENTE
  CONTESTADA
  REJEITADA
}

// Assinatura do Trade Marketing (separada do `plan` PlanType do ERP). Define o
// tier (Bronze/Prata/Ouro) que libera módulos e cotas de trade. `provider`/
// `externalId` são o gancho para a cobrança real (Stripe/Asaas) — hoje o plano
// é definido manualmente (status CORTESIA), sem transação.
model TradeSubscription {
  id               String                  @id @default(cuid())
  organizationId   String                  @unique
  plan             TradePlanTier
  status           TradeSubscriptionStatus @default(CORTESIA)
  currentPeriodEnd DateTime?
  provider         String?
  externalId       String?
  extraUsers       Int                     @default(0)
  extraPromoters   Int                     @default(0)
  extraPhotos      Int                     @default(0)
  extraStorageGb   Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("trade_subscriptions")
}

enum TradePlanTier {
  BRONZE
  PRATA
  OURO
}

enum TradeSubscriptionStatus {
  ATIVA // cobrança ativa (via provedor)
  CORTESIA // liberado manualmente, sem cobrança
  INADIMPLENTE // pagamento em atraso (mantém acesso em carência)
  CANCELADA // sem acesso aos módulos pagos
}

// Evento de comportamento do shopper (app do cliente). Append-only, sem FK — é a
// mangueira que alimenta o analytics de indústria. IDs (product/brand/supplier)
// são denormalizados na escrita pro rollup nunca re-juntar. anonId identifica o
// visitante sem login; shopperId preenche quando ele estiver logado (Fase B).
model ScanEvent {
  id             String        @id @default(cuid())
  organizationId String
  storeId        String
  kind           ScanEventKind
  barcode        String?
  productId      String?
  brandId        String?
  supplierId     String?
  sectorId       String?
  query          String?
  matched        Boolean       @default(false)
  anonId         String
  shopperId      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
  @@index([organizationId, storeId, createdAt])
  @@map("scan_events")
}

enum ScanEventKind {
  BARCODE_SCAN
  PRODUCT_SEARCH
  SECTOR_VIEW
  LOCATE
  UNKNOWN_BARCODE
}

// Cliente final (shopper) — identidade GLOBAL (sem organizationId), separada da
// equipe (User/Member). Login leve por bcrypt + token HMAC (sem cookie/sessão
// própria por enquanto). Favorita produtos, resgata cupons e recebe alerta de
// queda de preço.
model Shopper {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String?
  phone        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  favorites    Favorite[]
  redemptions  CouponRedemption[]

  @@map("shoppers")
}

// Produto favoritado pelo shopper. priceWhenFavorited guarda o preço no momento
// pra mostrar "baixou X%" na leitura; lastNotifiedPrice deduplica o alerta.
model Favorite {
  id                 String   @id @default(cuid())
  shopperId          String
  organizationId     String
  productId          String
  storeId            String?
  priceWhenFavorited Decimal  @db.Decimal(10, 2)
  notifyOnDrop       Boolean  @default(true)
  lastNotifiedPrice  Decimal? @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  shopper            Shopper  @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopperId, productId])
  @@index([productId])
  @@index([organizationId, productId])
  @@map("favorites")
}

// Cupom de desconto. funderSupplierId = indústria que patrocina (ROI mensurável).
// Alvo por produto/marca/categoria. Sem transação de pagamento — só o registro.
model Coupon {
  id               String             @id @default(cuid())
  organizationId   String
  productId        String?
  brandId          String?
  categoryId       String?
  funderSupplierId String?
  title            String
  type             CouponType
  value            Decimal            @db.Decimal(10, 2)
  minQty           Int?
  startsAt         DateTime?
  endsAt           DateTime?
  maxRedemptions   Int?
  perShopperLimit  Int                @default(1)
  personalized     Boolean            @default(false)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions      CouponRedemption[]

  @@index([organizationId, isActive])
  @@index([productId])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  shopperId  String
  storeId    String
  redeemedAt DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  shopper    Shopper  @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([shopperId])
  @@map("coupon_redemptions")
}

enum CouponType {
  PERCENT
  FIXED
}

// Override de preço/estoque POR LOJA (a Fase A lê por org; aqui refina sem
// backfill). Tudo nullable = override-com-fallback: o que for null cai no
// escalar do Product. A liquidação por validade grava aqui o promotionalPrice.
model StoreProduct {
  id               String   @id @default(cuid())
  organizationId   String
  storeId          String
  productId        String
  salePrice        Decimal? @db.Decimal(10, 2)
  promotionalPrice Decimal? @db.Decimal(10, 2)
  currentStock     Decimal? @db.Decimal(10, 3)
  minStock         Decimal? @db.Decimal(10, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([organizationId])
  @@map("store_products")
}

// Lote com validade por loja. Fonte pro repositor acompanhar vencimento e
// quantidade (evita dano ao consumidor e ruptura), junto do planograma.
model ProductBatch {
  id             String      @id @default(cuid())
  organizationId String
  storeId        String
  productId      String
  lote           String?
  validade       DateTime
  quantity       Decimal     @db.Decimal(10, 3)
  status         BatchStatus @default(OK)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, storeId, validade])
  @@index([productId])
  @@map("product_batches")
}

enum BatchStatus {
  OK
  NEAR_EXPIRY
  EXPIRED
  CLEARED
}

// Lead público do TradeGram: um visitante (sem login) demonstra interesse num
// espaço. Espaço LIVRE → INTERESSE; espaço ocupado → FILA_ESPERA. Mantém a
// negociação DENTRO da plataforma (não expõe contato do comercial). O dono da
// loja trabalha esses leads no inbox interno. O snapshot spaceCode/spaceLabel
// sobrevive à edição/regeneração do objeto do mapa.
model SpaceInterest {
  id             String              @id @default(cuid())
  organizationId String
  storeId        String
  mapObjectId    String?
  kind           SpaceInterestKind
  status         SpaceInterestStatus @default(NOVO)
  spaceCode      String?
  spaceLabel     String?
  name           String
  company        String?
  email          String?
  phone          String?
  message        String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  mapObject      MapObject?          @relation(fields: [mapObjectId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([storeId])
  @@index([mapObjectId])
  @@map("space_interests")
}

enum SpaceInterestKind {
  INTERESSE // espaço livre — quer negociar o ponto
  FILA_ESPERA // espaço ocupado — quer entrar na fila
}

enum SpaceInterestStatus {
  NOVO
  EM_CONTATO
  GANHO
  ARQUIVADO
}

model FloorPlan {
  id                  String          @id @default(cuid())
  organizationId      String
  storeId             String
  name                String
  widthM              Float           @default(50)
  heightM             Float           @default(50)
  pixelsPerMeter      Float           @default(50)
  backgroundImageKey  String?
  backgroundOpacity   Float           @default(1)
  backgroundTransform Json? // { x, y, scale, rotation } da planta importada
  defaultViewport     Json? // { x, y, zoom }
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store               Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  layers              MapLayer[]
  objects             MapObject[]
  annotations         MapAnnotation[]

  @@index([organizationId])
  @@index([storeId])
  @@map("floor_plans")
}

model MapLayer {
  id             String       @id @default(cuid())
  organizationId String
  floorPlanId    String
  name           String
  order          Int          @default(0)
  visible        Boolean      @default(true)
  locked         Boolean      @default(false)
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  floorPlan      FloorPlan    @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  objects        MapObject[]

  @@index([organizationId])
  @@index([floorPlanId])
  @@map("map_layers")
}

model MapObject {
  id                String             @id @default(cuid())
  organizationId    String
  floorPlanId       String
  layerId           String
  type              MapObjectType
  shapeKind         MapShapeKind       @default(RECT)
  geometry          Json // coordenadas em metros (engine-agnóstico 2D/3D)
  z                 Int                @default(0)
  heightM           Float? // extrusão para 3D futuro
  style             Json?
  // Painel lateral
  name              String?
  spaceState        MapSpaceState      @default(LIVRE) // 🟡 livre / 🟢 executado / 🔴 pendente
  spaceCode         String? // Digital Space ID (ex.: WS-009-GD-002-PERF) — editável, único por org
  spaceSeq          Int? // sequencial cru do spaceCode, p/ regenerar sem reparsear
  status            String? // DEPRECADO: texto livre legado, substituído por spaceState. Sai do banco quando o backfill de sectorId validar limpo
  category          String? // DEPRECADO: texto livre, substituído por sectorId. Mantido só p/ leitura de fallback
  responsibleName   String?
  lastVisitAt       DateTime?
  lastEditedById    String? // promotor que fez a última edição em campo (carimbado pelo servidor)
  properties        Json?
  supplierId        String? // Empresa/Indústria responsável
  brandId           String? // Marca
  // Biblioteca Nacional de Espaços Comerciais — classificação p/ comparar e
  // precificar entre lojas. Nenhum tem default: "não classificado" é estado real.
  mediaTypeId       String?
  sectorId          String?
  tier              SpaceTier?
  flowLevel         SpaceFlowLevel?
  visibility        SpaceVisibility?
  isExclusive       Boolean            @default(false)
  revenuePotential  Decimal?           @db.Decimal(12, 2)
  avgSalesAmount    Decimal?           @db.Decimal(12, 2) // venda média — entrada manual, não vem do ERP
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  floorPlan         FloorPlan          @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  layer             MapLayer           @relation(fields: [layerId], references: [id], onDelete: Cascade)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  lastEditedBy      User?              @relation("EditedMapObjects", fields: [lastEditedById], references: [id], onDelete: SetNull)
  mediaType         MediaType?         @relation(fields: [mediaTypeId], references: [id], onDelete: SetNull)
  sector            StoreSector?       @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  pdvPhotos         PdvPhoto[]
  annotations       MapAnnotation[]
  planogramFixtures PlanogramFixture[]
  negotiations      SpaceNegotiation[]
  spaceInterests    SpaceInterest[]

  @@unique([organizationId, spaceCode])
  @@index([organizationId])
  @@index([floorPlanId])
  @@index([floorPlanId, layerId])
  @@index([supplierId])
  @@index([brandId])
  @@index([lastEditedById])
  @@index([organizationId, spaceState])
  @@index([organizationId, mediaTypeId])
  @@index([organizationId, sectorId])
  @@map("map_objects")
}

// Histórico de negociações de um espaço do mapa (o "Gêmeo Digital" comercial).
// Cada negociação é um registro imutável — reabrir cria uma nova, preservando o
// histórico em vez de sobrescrever (diferente dos campos soltos em properties).
model SpaceNegotiation {
  id                String            @id @default(cuid())
  organizationId    String
  mapObjectId       String
  supplierId        String? // Indústria
  brandId           String?
  negotiationTypeId String?
  distributor       String?
  startDate         DateTime?
  endDate           DateTime?
  amount            Decimal?          @db.Decimal(12, 2)
  status            NegotiationStatus @default(RASCUNHO)
  notes             String?           @db.Text
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mapObject       MapObject        @relation(fields: [mapObjectId], references: [id], onDelete: Cascade)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  negotiationType NegotiationType? @relation(fields: [negotiationTypeId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("CreatedSpaceNegotiations", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([mapObjectId, createdAt(sort: Desc)])
  @@index([organizationId, endDate])
  @@index([organizationId, negotiationTypeId])
  @@map("space_negotiations")
}

// ============================================
// CATÁLOGOS PADRÃO DO TRADE (Biblioteca Nacional)
// Semeados por org na criação (afterCreateOrganization), editáveis. isSystemDefault
// marca os oficiais — podem ser renomeados/desativados, não excluídos.
// ============================================

enum MediaKind {
  FISICA
  DIGITAL
}

// AREA: preço sugerido = custo/m² × área real (gôndola, ilha...). FLAT: mídia
// sem área útil (wobbler, QR code, push) usa notionalAreaM2 (ou 1) fixo, senão
// cotaria R$ 0.
enum MediaPricingBasis {
  AREA
  FLAT
}

model MediaType {
  id              String            @id @default(cuid())
  organizationId  String
  kind            MediaKind         @default(FISICA)
  code            String // 2–3 chars: "PG", "LED", "APP"
  name            String
  description     String?           @db.Text
  examples        String[]          @default([])
  defaultPhotos   String[]          @default([]) // chaves R2 de fotos de referência
  occupancyRules  String?           @db.Text // regras de ocupação/apresentação padrão
  pricingBasis    MediaPricingBasis @default(AREA)
  basePrice       Decimal?          @db.Decimal(12, 2) // preço padrão da org, sobrescrito por MediaTypePrice por loja
  notionalAreaM2  Float?            @default(1) // área nominal (m²): usada por mídia FLAT, e por qualquer mídia no Catálogo PDV genérico (sem objeto/geometria real associada)
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  isSystemDefault Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mapObjects      MapObject[]
  prices          MediaTypePrice[]
  pdvPhotos       PdvPhoto[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, sortOrder])
  @@map("media_types")
}

// Foto modelo GLOBAL da Biblioteca Órbita — não é org-scoped: uma única
// biblioteca central, keyed pelo código padrão da mídia (PG, GO, IL...),
// visível a todos os usuários do sistema. Só o super-admin (ver
// src/lib/super-admin.ts) insere/apaga; ninguém mais altera. Cada org ainda
// pode ter as suas próprias fotos em MediaType.defaultPhotos.
model MediaModelPhoto {
  id        String   @id @default(cuid())
  code      String // código padrão da mídia (bate com MediaType.code)
  imageKey  String // chave R2 (já com watermark do Órbita)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([code])
  @@map("media_model_photos")
}

model NegotiationType {
  id                String             @id @default(cuid())
  organizationId    String
  code              String
  name              String
  isActive          Boolean            @default(true)
  sortOrder         Int                @default(0)
  isSystemDefault   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spaceNegotiations SpaceNegotiation[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, sortOrder])
  @@map("negotiation_types")
}

model StoreSector {
  id              String       @id @default(cuid())
  organizationId  String
  code            String // 3 chars
  name            String
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  isSystemDefault Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mapObjects      MapObject[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, sortOrder])
  @@map("store_sectors")
}

// Preço manual por loja+mídia — sobrescreve MediaType.basePrice/suggested. storeId
// é NOT NULL de propósito: com storeId opcional, o unique abaixo permitiria
// infinitas linhas "org-level" duplicadas (NULL não colide em UNIQUE no Postgres).
model MediaTypePrice {
  id             String       @id @default(cuid())
  organizationId String
  storeId        String
  mediaTypeId    String
  price          Decimal      @db.Decimal(12, 2)
  isManual       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  mediaType      MediaType    @relation(fields: [mediaTypeId], references: [id], onDelete: Cascade)

  @@unique([storeId, mediaTypeId])
  @@index([organizationId])
  @@map("media_type_prices")
}

// Config de precificação do Catálogo PDV, 1 por org (espelha SalesGoalRankingSettings).
model TradePricingSettings {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  markup                Float        @default(3)
  floorPrice            Decimal?     @db.Decimal(12, 2)
  tierMultipliers       Json         @default("{\"PREMIUM\":1.5,\"OURO\":1.2,\"PRATA\":1,\"BRONZE\":0.8}")
  flowMultipliers       Json         @default("{\"MUITO_ALTO\":1.4,\"ALTO\":1.15,\"MEDIO\":1,\"BAIXO\":0.85}")
  visibilityMultipliers Json         @default("{\"EXCELENTE\":1.2,\"BOA\":1,\"REGULAR\":0.85}")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("trade_pricing_settings")
}

// Benchmark de custo/m² por região — cadastro manual (item a do plano). `city`
// usa "" (não null) pro benchmark estadual: NULL não colide em UNIQUE no Postgres,
// então city opcional permitiria duplicar a mesma linha estadual várias vezes.
model RegionCostBenchmark {
  id             String       @id @default(cuid())
  organizationId String
  state          String
  city           String       @default("")
  costPerM2      Decimal      @db.Decimal(12, 2)
  source         String?
  year           Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, state, city])
  @@index([organizationId])
  @@map("region_cost_benchmarks")
}

model Brand {
  id             String             @id @default(cuid())
  organizationId String
  // Opcional: importar "OMO" de uma planilha de 400k produtos sem saber a
  // indústria criaria fornecedores-fantasma poluindo /fornecedores. Relaxar o
  // NOT NULL é aditivo — nenhuma marca existente viola.
  supplierId     String? // Indústria (Supplier) dona da marca, quando conhecida
  name           String
  logo           String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  mapObjects     MapObject[]
  negotiations   SpaceNegotiation[]
  products       Product[]

  @@index([organizationId])
  @@index([supplierId])
  @@map("brands")
}

model PdvPhoto {
  id                 String                 @id @default(cuid())
  organizationId     String
  storeId            String // sempre presente (fallback quando não há mapa)
  mapObjectId        String? // objeto do mapa (gôndola/ilha) quando houver
  supplierId         String? // Indústria
  mediaTypeId        String? // tipo de mídia fotografada — fonte de verdade quando não há mapObject
  section            String? // Seção
  responsibleCompany String? // Empresa responsável pelo PDV
  managerName        String? // Gerente da loja na visita — snapshot editável; vazio cai no Store.managerName
  coordinatorName    String? // Coordenador(a) do PDV
  consultantName     String? // Consultor(a) do PDV
  code               String? // Código
  actionValue        Decimal?               @db.Decimal(10, 2) // Valor da ação (R$)
  photos             String[] // chaves R2 das fotos
  photoLayout        PdvPhotoLayoutPattern? // padrão de disposição das fotos (2 ou 3 fotos)
  photoAdjustments   Json? // Record<chave R2, { zoom: number; posX: number; posY: number }> — enquadramento (pan/zoom) de cada foto dentro do slot fixo
  capturedAt         DateTime               @default(now())
  notes              String?                @db.Text
  // Captura do promotor: snapshot do nome + geolocalização (reverse-geocode).
  promoterName       String?
  capturedCity       String?
  capturedState      String?
  /// Endereço textual resolvido na captura. Prova de onde a foto foi tirada,
  /// independente de a loja ter sido corrigida depois.
  capturedAddress    String?
  capturedLatitude   Float?
  capturedLongitude  Float?
  // Captura salva SEM o selo da indústria (o carimbo não pôde ser carregado no
  // celular do promotor). Marca a foto para a coordenadora aplicar o selo em
  // /books em vez de reprovar e mandar refazer a visita.
  sealMissing        Boolean                @default(false)
  // Aprovação da foto pela coordenadora (QC antes de entrar no book).
  approvalStatus     BookItemApproval       @default(PENDING)
  approvalNote       String?
  reviewedById       String?
  reviewedByName     String?
  reviewedAt         DateTime?
  createdById        String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store              Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  mapObject          MapObject?             @relation(fields: [mapObjectId], references: [id], onDelete: SetNull)
  supplier           Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  mediaType          MediaType?             @relation(fields: [mediaTypeId], references: [id], onDelete: SetNull)
  createdBy          User                   @relation("CreatedPdvPhotos", fields: [createdById], references: [id])
  bookItems          BookItem[]

  @@index([organizationId])
  @@index([organizationId, storeId])
  @@index([organizationId, createdById, capturedAt])
  @@index([organizationId, capturedAt])
  @@index([mapObjectId])
  @@index([organizationId, code])
  @@index([organizationId, supplierId])
  @@index([organizationId, mediaTypeId])
  @@index([organizationId, createdById])
  @@index([organizationId, approvalStatus])
  @@map("pdv_photos")
}

model Book {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  supplierId        String? // Indústria (opcional): logo + marcas. Sem = book geral de ações
  distributorLogo   String? // default = Organization.logo
  periodMonth       Int
  periodYear        Int
  status            BookStatus   @default(DRAFT)
  pdfKey            String? // PDF gerado (R2)
  generatedAt       DateTime?
  // Layout livre (array de CoverElement) da capa/página final, editado no
  // canvas Konva. null = usa o layout fixo legado em book-document.tsx.
  coverLayout       Json?
  closingLayout     Json?
  // Layout livre das páginas de PDV. Aplicado a TODOS os itens do book, com
  // variáveis e slots de foto resolvidos por item. null = layout fixo legado.
  pageLayout        Json?
  // Fundo da página { color: string, opacity: number 0-1 }. null = branco opaco.
  coverBackground   Json?
  closingBackground Json?
  pageBackground    Json?
  // Envio do book à indústria/fornecedor para liberar a verba. Snapshot de
  // quem enviou, sem relation, pra exibir sem join.
  sentAt            DateTime?
  sentById          String?
  sentByName        String?
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier          Supplier?    @relation(fields: [supplierId], references: [id])
  createdBy         User         @relation("CreatedBooks", fields: [createdById], references: [id])
  items             BookItem[]

  @@index([organizationId])
  @@index([supplierId])
  @@map("books")
}

// DEPRECADO em favor de BookTemplate (supplierId = null). Mantido só para a
// migração de dados não perder os padrões já salvos; pode ser removido depois
// que o backfill rodar em produção.
model BookCoverTemplate {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  coverLayout       Json
  closingLayout     Json
  coverBackground   Json?
  closingBackground Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("book_cover_templates")
}

// Padrão visual de book salvo e reaplicável. Cada indústria/fornecedor tem os
// seus (supplierId preenchido); supplierId null é o padrão da organização,
// usado nos books sem indústria e como base copiada ao criar o primeiro
// padrão de uma indústria. A cópia é por valor: editar o padrão da org depois
// não altera os padrões das indústrias.
model BookTemplate {
  id                String       @id @default(cuid())
  organizationId    String
  supplierId        String?
  name              String
  // Marca qual padrão é carregado por default nos books daquela indústria.
  isDefault         Boolean      @default(false)
  coverLayout       Json
  closingLayout     Json
  pageLayout        Json?
  coverBackground   Json?
  closingBackground Json?
  pageBackground    Json?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier          Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([organizationId, supplierId, name])
  @@index([organizationId, supplierId])
  @@map("book_templates")
}

model BookItem {
  id             String           @id @default(cuid())
  bookId         String
  pdvPhotoId     String
  order          Int              @default(0)
  // Layout próprio desta página, sobrescrevendo o do book. null = usa
  // Book.pageLayout; se este também for null, cai no layout fixo legado.
  // Permite uma página de abertura com um padrão e as de PDV com outro.
  pageLayout     Json?
  pageBackground Json?
  // Aprovação da coordenadora. reviewedByName é snapshot pra exibir sem join.
  approvalStatus BookItemApproval @default(PENDING)
  approvalNote   String?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  book           Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pdvPhoto       PdvPhoto         @relation(fields: [pdvPhotoId], references: [id], onDelete: Cascade)

  @@unique([bookId, pdvPhotoId])
  @@index([bookId])
  @@index([bookId, approvalStatus])
  @@map("book_items")
}

// Padrão de UMA página, salvo a partir do editor e reaplicável ao adicionar
// páginas novas. Diferente de BookTemplate, que guarda o visual do book
// inteiro (capa + página final + páginas).
model BookPageTemplate {
  id             String       @id @default(cuid())
  organizationId String
  supplierId     String?
  name           String
  layout         Json
  background     Json?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([organizationId, supplierId, name])
  @@index([organizationId, supplierId])
  @@map("book_page_templates")
}

// Catálogo visual de oportunidades de PDV — material que o Trade Marketing envia
// a fornecedores/indústrias pra vender os espaços. Reaproveita o editor de capa
// e o pipeline de PDF dos Books. shareToken dá link público (sem login).
model TradeCatalog {
  id                String             @id @default(cuid())
  organizationId    String
  name              String
  status            TradeCatalogStatus @default(DRAFT)
  pdfKey            String? // PDF gerado (R2)
  generatedAt       DateTime?
  // Sem @default(cuid()): cuid é anti-colisão, não imprevisível (timestamp +
  // contador + fingerprint + ~20 bits de aleatório). Como este token é a ÚNICA
  // barreira do link sem login, quem tem um consegue enumerar os vizinhos.
  // Gerado com randomBytes em trade-catalog/catalog-doc/create.ts.
  shareToken        String             @unique // link público
  isPublic          Boolean            @default(false)
  showIndex         Boolean            @default(true)
  // Mesmo formato do Book (array de CoverElement) — reusa o editor Konva e o
  // replay no PDF. null = capa/contracapa em branco.
  coverLayout       Json?
  closingLayout     Json?
  coverBackground   Json?
  closingBackground Json?
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("CreatedTradeCatalogs", fields: [createdById], references: [id])
  pages             TradeCatalogPage[]

  @@index([organizationId])
  @@map("trade_catalogs")
}

// Página do catálogo (ex.: "Ponta de Gôndolas"). rows é um snapshot editável das
// oportunidades — { id, storeId?, storeName, mediaTypeName, quantity, price,
// status, note? }[] — pra a proposta enviada não mudar sozinha quando o mapa muda.
model TradeCatalogPage {
  id            String       @id @default(cuid())
  catalogId     String
  title         String
  mediaTypeCode String? // origem da geração automática
  order         Int          @default(0)
  photoKeys     String[]     @default([]) // fotos do Cadastros de Trade (R2)
  rows          Json         @default("[]")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  catalog       TradeCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([catalogId, order])
  @@map("trade_catalog_pages")
}

model MapAnnotation {
  id             String            @id @default(cuid())
  organizationId String
  floorPlanId    String
  mapObjectId    String?
  type           MapAnnotationType @default(PIN)
  x              Float // metros
  y              Float // metros
  text           String?           @db.Text
  status         String?
  authorId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  floorPlan      FloorPlan         @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  mapObject      MapObject?        @relation(fields: [mapObjectId], references: [id], onDelete: Cascade)
  author         User?             @relation("AuthoredAnnotations", fields: [authorId], references: [id])

  @@index([organizationId])
  @@index([floorPlanId])
  @@map("map_annotations")
}

// ============================================
// PLANOGRAMA — exposição de produtos na gôndola
// ============================================
// Relacional até o item porque o produto precisa ser consultável ("em quais
// planogramas o SKU X aparece", "quantos facings da OMO na rede"). JSON só onde
// o dado nunca é consultado por dentro: o snapshot da versão e as divisórias.
// Tudo em MILÍMETRO INTEIRO — somar dezenas de larguras em float acumula deriva.

enum PlanogramStatus {
  RASCUNHO
  EM_APROVACAO
  ATIVO
  ARQUIVADO
}

enum FixtureKind {
  GONDOLA
  PONTA_GONDOLA
  ILHA
  CHECKOUT
  GELADEIRA
  EXPOSITOR
  CLIP_STRIP
}

enum ShelfKind {
  PRATELEIRA
  GANCHEIRA
  CESTO
  CAIXARIA
}

enum ShelfLayoutMode {
  PACKED // produtos encostados, posição derivada da ordem
  FREE // posição livre em xMm
}

enum ItemOrientation {
  FRENTE
  LADO
  TOPO
}

model Planogram {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  code           String?
  categoryId     String? // sub-segmento alvo
  status         PlanogramStatus    @default(RASCUNHO)
  isActive       Boolean            @default(false) // toggle "Ativar Planograma"
  releaseAt      DateTime? // "Agendar Liberação"
  expiresAt      DateTime?
  currentVersion Int                @default(1)
  decisionTree   Json? // parâmetros da árvore de decisão — Fase 4
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy      User               @relation("CreatedPlanograms", fields: [createdById], references: [id])
  fixtures       PlanogramFixture[]
  items          PlanogramItem[]
  versions       PlanogramVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@map("planograms")
}

model PlanogramFixture {
  id             String            @id @default(cuid())
  organizationId String
  planogramId    String
  kind           FixtureKind       @default(GONDOLA)
  name           String
  order          Int               @default(0)
  widthMm        Int               @default(1300) // largura de UM módulo
  heightMm       Int               @default(1900)
  depthMm        Int               @default(400)
  baseHeightMm   Int               @default(100) // rodapé
  colorHex       String? // campo "Modelo" do WebJasper
  // Vínculo OPCIONAL com a gôndola desenhada em Lojas e Mapas. O planograma
  // precisa existir sem mapa nenhum — por isso não é o MapObject que manda.
  mapObjectId    String?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planogram      Planogram         @relation(fields: [planogramId], references: [id], onDelete: Cascade)
  mapObject      MapObject?        @relation(fields: [mapObjectId], references: [id], onDelete: SetNull)
  modules        PlanogramModule[]

  @@index([planogramId, order])
  @@index([organizationId])
  @@map("planogram_fixtures")
}

/// Gôndola salva como padrão da rede. Supermercados repetem o mesmo
/// dimensionamento em toda a loja, então o padrão vira o ponto de partida de
/// qualquer gôndola nova em vez de reconfigurar tudo a cada planograma.
model PlanogramFixtureTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  kind           FixtureKind  @default(GONDOLA)
  widthMm        Int
  heightMm       Int
  depthMm        Int
  baseHeightMm   Int
  colorHex       String?
  moduleCount    Int          @default(1)
  /// [{ yMm, widthMm, depthMm, thicknessMm, kind, colorHex }] — as prateleiras
  /// exatamente onde estavam, não só a contagem: a altura de cada nível É o
  /// padrão da loja.
  shelves        Json
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
  @@map("planogram_fixture_templates")
}

model PlanogramModule {
  id             String           @id @default(cuid())
  organizationId String
  fixtureId      String
  index          Int // "Módulo 2/2"
  widthMm        Int              @default(1300)
  label          String?
  fixture        PlanogramFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  shelves        PlanogramShelf[]

  @@unique([fixtureId, index])
  @@index([organizationId])
  @@map("planogram_modules")
}

model PlanogramShelf {
  id             String          @id @default(cuid())
  organizationId String
  moduleId       String
  index          Int // 0 = mais baixa
  yMm            Int // topo da prateleira, a partir do piso
  widthMm        Int
  depthMm        Int // fica na prateleira: a base costuma ser mais funda
  thicknessMm    Int             @default(25)
  kind           ShelfKind       @default(PRATELEIRA)
  layoutMode     ShelfLayoutMode @default(PACKED)
  maxWeightKg    Float?
  colorHex       String? // null = herda a cor padrão da longarina
  dividers       Json? // [{ xMm }] — poucas e nunca consultadas isoladamente
  module         PlanogramModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  items          PlanogramItem[]

  @@unique([moduleId, index])
  @@index([organizationId])
  @@map("planogram_shelves")
}

model PlanogramItem {
  id             String          @id @default(cuid())
  organizationId String
  // Denormalizado: permite "em quais planogramas está o SKU X" sem 4 joins.
  planogramId    String
  shelfId        String
  productId      String
  position       Int // ordem na prateleira (fonte de verdade no modo PACKED)
  xMm            Int? // só usado quando layoutMode = FREE
  facings        Int             @default(1)
  facingsDeep    Int             @default(1)
  facingsHigh    Int             @default(1)
  orientation    ItemOrientation @default(FRENTE)
  isBoxed        Boolean         @default(false) // exposto na caixa fechada
  // SNAPSHOT da medida do produto no momento em que foi posicionado: corrigir o
  // cadastro do SKU depois não pode alterar sozinho um planograma já aprovado.
  widthMm        Int
  heightMm       Int
  depthMm        Int
  note           String?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planogram      Planogram       @relation(fields: [planogramId], references: [id], onDelete: Cascade)
  shelf          PlanogramShelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([shelfId, position])
  @@index([planogramId, productId])
  @@index([organizationId, productId])
  @@map("planogram_items")
}

model PlanogramVersion {
  id             String    @id @default(cuid())
  organizationId String
  planogramId    String
  version        Int
  label          String?
  snapshot       Json // árvore completa serializada — só lida inteira
  // Pré-calculados para diff e dashboard sem precisar abrir o snapshot.
  itemCount      Int       @default(0)
  facingCount    Int       @default(0)
  linearMm       Int       @default(0)
  createdById    String
  createdAt      DateTime  @default(now())
  planogram      Planogram @relation(fields: [planogramId], references: [id], onDelete: Cascade)
  createdBy      User      @relation("CreatedPlanogramVersions", fields: [createdById], references: [id])

  @@unique([planogramId, version])
  @@index([organizationId])
  @@map("planogram_versions")
}

// ============================================
// INTEGRAÇÃO COM ERP EXTERNO
// ============================================
// Camada canônica. O NERP espelha aqui as vendas de qualquer origem, sempre com
// a mesma forma; ranking e dashboards leem só destas tabelas e nunca sabem se o
// dado veio do Winthor, de outro ERP ou das vendas nativas. Quem traduz é o
// conector em `src/features/erp-sync/server/connectors/` — é o único lugar do
// código onde nome de ERP pode aparecer.
//
// A aplicação NUNCA consulta o ERP em request: o sync é assíncrono e escreve
// aqui. Conexões de ERP são somente-leitura (ver `oracle-client.ts`).

enum ErpConnectionKind {
  NATIVE // sem ERP externo: o vendido sai de Sale (comportamento padrão)
  WINTHOR_ORACLE // TOTVS Winthor sobre Oracle
}

enum ErpConnectionStatus {
  ACTIVE
  PAUSED
  ERROR
}

// Uma origem de venda por organização — é o que torna `resolveSalesConnector`
// determinístico e evita dois "vendido" concorrentes no ranking.
model ErpConnection {
  id               String              @id @default(cuid())
  organizationId   String              @unique
  kind             ErpConnectionKind   @default(NATIVE)
  status           ErpConnectionStatus @default(ACTIVE)
  // Credenciais + schema do ERP, cifrados com AES-256-GCM (mesmo cofre do S2S,
  // `src/lib/nasa-s2s-crypto.ts`). NATIVE não usa. Nunca sai para o client.
  configCiphertext String?
  // Marcado ao disparar o sync e limpo ao terminar. `status` continua sendo
  // saúde da conexão, não etapa — misturar os dois esconderia um ERROR atrás de
  // um "sincronizando". Sync travado se reconhece por `syncStartedAt` antigo.
  syncStartedAt    DateTime?
  lastSyncAt       DateTime?
  lastSyncError    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("erp_connections")
}

// Vendedor do ERP ↔ Member do NERP. É o ÚNICO lugar desse vínculo:
// SalesGoalEntry.externalCode resolve através daqui, para não existirem duas
// verdades sobre quem é quem.
model ExternalSeller {
  id             String  @id @default(cuid())
  organizationId String
  externalCode   String // PCUSUARI.CODUSUR no Winthor
  name           String
  branchCode     String? // filial do ERP; não confiável como chave (vem null/99)
  supervisorCode String?
  supervisorName String? // nome da equipe (PCSUPERV.NOME) — divisão do ranking
  // Código que não é pessoa (Winthor: CODUSUR 7 = CHECK-OUT BOMBONIERE).
  // Fica fora do ranking de pessoas; conta como canal.
  isBucket       Boolean @default(false)
  isActive       Boolean @default(true)
  memberId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalCode])
  @@index([organizationId])
  @@index([memberId])
  @@map("external_sellers")
}

// Grão: dia × vendedor. Uma org com 34 vendedores ativos gera ~12 k linhas/ano —
// barato de reprocessar por inteiro quando a regra mudar.
//
// A filial NÃO entra no grão: o mesmo vendedor pode faturar por duas filiais no
// mesmo dia, e o ranking atribui a venda à pessoa. A filial que importa é a do
// vendedor, que vive em `ExternalSeller.branchCode`.
//
// Sem FK para ExternalSeller de propósito: dado de ERP tem código órfão (pedido
// apontando para vendedor que sumiu do cadastro), e uma FK derrubaria o sync
// inteiro por causa de uma linha. Os órfãos são reportados pelo job.
model SalesFactDaily {
  id                 String   @id @default(cuid())
  organizationId     String
  date               DateTime @db.Date
  sellerExternalCode String
  // Bucket FATURADO (posicao = 'F'): só nota emitida, a receita conservadora.
  revenue            Decimal  @db.Decimal(15, 2)
  cost               Decimal  @db.Decimal(15, 2)
  orders             Int      @default(0)
  customers          Int      @default(0)
  // Bucket PIPELINE (posicao <> 'C'): todo pedido não cancelado, incluindo em
  // andamento. É o número que o relatório de supervisor do Winthor mostra, e é
  // um superconjunto do faturado. O board deixa o usuário escolher qual conta.
  revenuePipeline    Decimal  @default(0) @db.Decimal(15, 2)
  costPipeline       Decimal  @default(0) @db.Decimal(15, 2)
  ordersPipeline     Int      @default(0)
  customersPipeline  Int      @default(0)

  syncedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date, sellerExternalCode])
  @@index([organizationId, date])
  @@index([organizationId, sellerExternalCode])
  @@map("sales_facts_daily")
}

// ============================================
// DASHBOARD PERSONALIZÁVEL (widgets)
// ============================================

enum DashboardWidgetDisplayType {
  STAT
  CHART
  LIST
  MAP
  TABLE
}

enum DashboardWidgetChartKind {
  LINE
  BAR
  DONUT
}

// Um widget do dashboard de UM membro — o dashboard é por pessoa, não por org.
// `dataSourceKey` aponta pro registry em código (src/app/router/dashboard-widgets/_registry.ts),
// ex.: "native.salesTotal", "ranking.teamRankingTop", "manual.<DashboardManualMetric.id>".
model DashboardWidget {
  id            String                     @id @default(cuid())
  memberId      String
  dataSourceKey String
  // Nome escolhido pelo usuário. Null = usa o rótulo padrão da fonte. Existe
  // como coluna (e não dentro de `options`) porque é metadado de exibição
  // renderizado em todo widget, igual a `color`/`icon`.
  title         String?
  displayType   DashboardWidgetDisplayType
  chartKind     DashboardWidgetChartKind?
  // Chave de uma paleta pastel fixa (ex.: "rose", "sky") — nunca cor livre,
  // valida contra a paleta em código no handler. Null = usa o padrão do tema.
  color         String?
  // Chave de um ícone lucide curado (ex.: "TrendingUp") — mesma validação
  // enum-only de `color`, nunca string livre. Null = sem ícone.
  icon          String?
  // Overrides por instância (período, top-N, meta/targetValue…) — validado em
  // runtime pelo registry, não pelo schema, mesmo espírito do Json solto de
  // Book.pageLayout.
  options       Json?
  // Layout[] do react-grid-layout por breakpoint: { lg: {x,y,w,h}, md: {...}, sm: {...} }.
  // xxs não guarda posição própria — mobile é sempre lista empilhada, na ordem
  // de `sortOrder`, não de x/y (que só fazem sentido nos breakpoints largos).
  layout        Json
  sortOrder     Int                        @default(0)
  // Widget aninhado: quando preenchido, este widget NÃO ocupa espaço na grade
  // — ele é renderizado compacto dentro do card do pai (ex.: "Venda total" no
  // topo e "Filial X"/"Filial Y" logo abaixo, cada um com filtro próprio).
  // Um nível só: filho não tem filho, senão o card vira árvore ilegível.
  parentId      String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  member   Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  parent   DashboardWidget?  @relation("WidgetChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children DashboardWidget[] @relation("WidgetChildren")

  @@index([memberId])
  @@index([parentId])
  @@map("dashboard_widgets")
}

// Resultado materializado de uma consulta customizada ao Oracle.
//
// Existe para que RENDERIZAR o dashboard nunca abra conexão com o ERP do
// cliente: `resolveValues` só lê daqui. Assim a carga no Oracle passa a ser
// (consultas distintas × frequência de atualização) em vez de escalar com o
// número de abas abertas. Mesmo princípio do espelho SalesFactDaily, só que
// por consulta em vez de por fato de venda.
//
// Chaveado por `fingerprint` (sha256 da config canonicalizada + orgId), então
// duas pessoas com a MESMA consulta compartilham o snapshot — de propósito,
// menos carga no ERP. O orgId dentro do hash impede cruzamento entre orgs.
model OracleWidgetSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  fingerprint    String
  // WidgetValue serializado. Null quando a última tentativa falhou — o widget
  // mostra o erro em vez de sumir.
  value          Json?
  error          String?
  computedAt     DateTime @default(now())
  durationMs     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fingerprint])
  @@index([organizationId])
  @@map("oracle_widget_snapshots")
}

// Consulta salva como modelo reutilizável ("padrão de busca").
//
// Escopo é a ORGANIZAÇÃO, não o member: quem monta "Faturamento por filial"
// compartilha com os outros admins em vez de cada um remontar. Só admin cria
// widget Oracle, então o público é o mesmo.
model OracleQueryTemplate {
  id             String                     @id @default(cuid())
  organizationId String
  name           String
  description    String?
  // Config do montador (mesmo shape de DashboardWidget.options.oracle),
  // validada em runtime pelo schema Zod, não pelo Prisma.
  config         Json
  displayType    DashboardWidgetDisplayType
  createdById    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Member?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("oracle_query_templates")
}

// Métrica digitada à mão pelo admin (ex.: "Meta da diretoria: R$ 500.000") —
// fica disponível como fonte de dado pra qualquer widget da org.
model DashboardManualMetric {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  value          Decimal  @db.Decimal(15, 2)
  // "currency" | "number" | "percent" — validado em zod no handler, não enum,
  // pra não precisar de migration só pra adicionar uma unidade nova.
  unit           String   @default("number")
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    Member?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("dashboard_manual_metrics")
}

// "Dashboard da organização" — modelo compartilhado que o owner/admin monta e
// os outros membros consomem, sujeito a permissão por widget. Existe UM por
// organização (constraint `@unique` em organizationId). Convivendo com os
// dashboards pessoais em `DashboardWidget` — cada gerente continua com o
// próprio, e ganha uma aba a mais para ver o modelo da organização.
model OrgDashboard {
  id             String   @id @default(cuid())
  organizationId String   @unique
  name           String   @default("Dashboard da organização")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Compartilhamento público (leitura, sem login) — mesmo padrão dos QRs
  // públicos do TradeGram. Rotacionar o token = revogar todos os links
  // anteriores. Ausente = não compartilhado.
  shareToken             String?  @unique
  publicName             String?
  // Subconjunto dos widgets que aparecem no link público. Vazio = nenhum
  // visível (o link cai numa tela vazia com aviso, e não escapa dado).
  publicVisibleWidgetIds String[] @default([])

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Member?              @relation("OrgDashboardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  widgets      OrgDashboardWidget[]
  panels       OrgDashboardPanel[]

  @@index([shareToken])
  @@map("org_dashboards")
}

// "Painel" = agrupamento visual de widgets por categoria (Comercial, Estoque,
// Frota, Logística, Operacional, Financeiro, Mapa, IA). Cada painel tem cor,
// título editável e sua própria ordem de widgets DENTRO dele — o dashboard
// como um todo é uma coleção de painéis + widgets fora de painel (legado).
//
// `templateKey` guarda de qual template o painel nasceu — permite futuramente
// oferecer "restaurar padrão" ou identificar visualmente qual pré-configurado
// o admin escolheu.
model OrgDashboardPanel {
  id             String   @id @default(cuid())
  orgDashboardId String
  // Categoria fixa (enum lógica, string aqui pra evitar migration a cada
  // nova categoria adicionada no catálogo de templates).
  category       String
  title          String
  // Cor do cabeçalho do painel: chave da paleta OU hex livre (mesmo shape
  // que `WidgetColor` do widget). null = cor padrão da categoria.
  color          String?
  sortOrder      Int      @default(0)
  /// Layout do painel na grade do dashboard (por breakpoint). Se null, o
  /// painel entra empilhado abaixo dos existentes na primeira renderização.
  layout         Json?
  /// Slug do template usado para criar o painel (`comercial-basico`,
  /// `logistica-detalhada`, ...). Nunca varia depois de criado.
  templateKey    String?
  /// Personalização visual do painel (fundo, contorno, cor do contorno, fonte
  /// do título). Mesmo padrão de `options.appearance` do widget — JSON pra não
  /// virar 6 colunas opcionais. null = padrão (só a `color`).
  appearance     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orgDashboard OrgDashboard         @relation(fields: [orgDashboardId], references: [id], onDelete: Cascade)
  widgets      OrgDashboardWidget[]

  @@index([orgDashboardId])
  @@map("org_dashboard_panels")
}

// Widget do dashboard da organização. Mesmo shape de `DashboardWidget` no que
// importa (dataSourceKey, options, layout, parent) — mas dono é o
// OrgDashboard, não o Member. Nada de `sortOrder` compartilhado com o
// pessoal: a ordem aqui é independente da lista pessoal do member.
model OrgDashboardWidget {
  id             String                     @id @default(cuid())
  orgDashboardId String
  /// Se preenchido, o widget vive DENTRO de um painel — o layout dele é
  /// interno ao painel, e ele some do grid raiz quando o painel é
  /// removido. null = widget "solto" na raiz (compatível com o modo antigo).
  panelId        String?
  dataSourceKey  String
  title          String?
  displayType    DashboardWidgetDisplayType
  chartKind      DashboardWidgetChartKind?
  color          String?
  icon           String?
  options        Json?
  layout         Json
  sortOrder      Int                        @default(0)
  parentId       String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  orgDashboard OrgDashboard                   @relation(fields: [orgDashboardId], references: [id], onDelete: Cascade)
  panel        OrgDashboardPanel?             @relation(fields: [panelId], references: [id], onDelete: Cascade)
  parent       OrgDashboardWidget?            @relation("OrgWidgetChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     OrgDashboardWidget[]           @relation("OrgWidgetChildren")
  permissions  OrgDashboardMemberPermission[]

  @@index([orgDashboardId])
  @@index([panelId])
  @@index([parentId])
  @@map("org_dashboard_widgets")
}

// Deny-by-default: se não existe linha para (member, widget), o membro NÃO
// vê o widget. Owner/admin ignora essa tabela (mesmo comportamento de
// `PAGE_PERMISSIONS`) — não precisa ser configurado item a item pra eles.
model OrgDashboardMemberPermission {
  memberId             String
  orgDashboardWidgetId String
  createdAt            DateTime @default(now())

  member             Member             @relation("OrgDashboardMemberPermissions", fields: [memberId], references: [id], onDelete: Cascade)
  orgDashboardWidget OrgDashboardWidget @relation(fields: [orgDashboardWidgetId], references: [id], onDelete: Cascade)

  @@id([memberId, orgDashboardWidgetId])
  @@index([memberId])
  @@index([orgDashboardWidgetId])
  @@map("org_dashboard_member_permissions")
}

// ============================================
// CALENDÁRIO DE EVENTOS (Trade Marketing)
// ============================================

enum CalendarEventType {
  ACAO_PDV
  CAMPANHA
  VISITA
  TREINAMENTO
  REUNIAO
  LANCAMENTO
  OUTRO
}

enum CalendarEventStatus {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

// Quem enxerga o evento. ORG = a organização inteira. LINKED = só quem tem
// vínculo (PromoterStore/PromoterSupplier) com alguma loja ou indústria alvo.
// Explícito de propósito: derivar de "tem alvo?" impediria uma ação de 20 lojas
// de ser anunciada para a equipe toda.
enum CalendarVisibility {
  ORG
  LINKED
}

model CalendarEvent {
  id             String              @id @default(cuid())
  organizationId String
  title          String
  description    String?             @db.Text
  type           CalendarEventType   @default(ACAO_PDV)
  status         CalendarEventStatus @default(PLANEJADO)
  visibility     CalendarVisibility  @default(ORG)
  color          String? // hex; null = cor derivada do `type`
  // Instantes UTC. `isAllDay` diz se a hora deve ser ignorada na renderização —
  // o dia LOCAL nunca é derivado no servidor (ele roda em UTC, o usuário não).
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean             @default(true)
  location       String?
  createdById    String // Member.id, não User.id
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      Member                  @relation("CalendarEventAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  stores         CalendarEventStore[]
  suppliers      CalendarEventSupplier[]
  assignees      CalendarEventAssignee[]
  checklistItems CalendarChecklistItem[]

  @@index([organizationId, startsAt, endsAt])
  @@index([createdById])
  @@map("calendar_events")
}

model CalendarEventStore {
  id             String        @id @default(cuid())
  organizationId String
  eventId        String
  storeId        String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([eventId, storeId])
  @@index([organizationId])
  @@index([storeId])
  @@map("calendar_event_stores")
}

model CalendarEventSupplier {
  id             String        @id @default(cuid())
  organizationId String
  eventId        String
  supplierId     String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([eventId, supplierId])
  @@index([organizationId])
  @@index([supplierId])
  @@map("calendar_event_suppliers")
}

// Item do checklist: é o ROTEIRO do evento, criado pela coordenação.
/// Promotores designados para a ação. É o vínculo DIRETO: a visibilidade por
/// loja/indústria responde "quem atende isso"; esta tabela responde "quem a
/// coordenação escalou", que nem sempre é a mesma pessoa.
model CalendarEventAssignee {
  id             String        @id @default(cuid())
  organizationId String
  eventId        String
  memberId       String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member         Member        @relation("CalendarEventAssignee", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([organizationId])
  @@index([memberId])
  @@map("calendar_event_assignees")
}

model CalendarChecklistItem {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  title          String
  description    String?  @db.Text
  position       Int      @default(0)
  isRequired     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        CalendarEvent                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  completions  CalendarChecklistCompletion[]

  @@index([eventId, position])
  @@index([organizationId])
  @@map("calendar_checklist_items")
}

// Execução: uma linha por (item, promotor, loja). É isto que responde "quem fez
// o quê" numa ação que vale para 20 lojas — por isso a conclusão não fica no
// item, que é compartilhado.
model CalendarChecklistCompletion {
  id             String   @id @default(cuid())
  organizationId String
  itemId         String
  memberId       String
  storeId        String? // null quando o evento não tem loja alvo
  note           String?  @db.Text
  doneAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         CalendarChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member       Member                @relation("CalendarChecklistDoer", fields: [memberId], references: [id], onDelete: Cascade)
  store        Store?                @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // ATENÇÃO: no Postgres NULL é distinto de NULL num UNIQUE, então isto NÃO
  // deduplica quando `storeId` é nulo. A migração cria um índice parcial para
  // esse caso, e o handler grava com deleteMany+create em vez de upsert.
  @@unique([itemId, memberId, storeId])
  @@index([organizationId, memberId])
  @@index([itemId])
  @@index([storeId])
  @@map("calendar_checklist_completions")
}

// Anotação privada do promotor. Modelo à parte do CalendarEvent DE PROPÓSITO:
// com uma flag `isPrivate`, toda consulta do módulo teria que lembrar de
// excluir a nota alheia, e esquecer em um lugar vaza a agenda pessoal para a
// organização inteira. Aqui é impossível uma consulta de evento devolver nota.
/// Item do checklist da anotação privada. Sem tabela de conclusão por membro
/// como no evento: a anotação tem um dono só, então `isDone` no próprio item
/// já responde tudo.
model CalendarNoteTask {
  id             String   @id @default(cuid())
  organizationId String
  noteId         String
  title          String
  isDone         Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  note         CalendarNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, position])
  @@index([organizationId])
  @@map("calendar_note_tasks")
}

model CalendarNote {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String // dono; única pessoa que lê ou escreve
  title          String
  content        String?  @db.Text
  color          String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member             @relation("CalendarNoteAuthor", fields: [memberId], references: [id], onDelete: Cascade)
  tasks        CalendarNoteTask[]

  @@index([organizationId, memberId, startsAt])
  @@map("calendar_notes")
}
