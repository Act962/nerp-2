{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "SEED_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_BASE_DOMAIN",
    "NEXT_PUBLIC_DOMAIN",
    "NEXT_PUBLIC_S3_BUCKET_CONSTRUCTOR_URL",
    "NEXT_PUBLIC_S3_BUCKET_NAME_IMAGES",
    "DESKTOP_ALLOWED_ORIGINS",
    "AWS_*",
    "STRIPE_*",
    "ASSAS_*",
    "GOOGLE_*",
    "NASA_*",
    "COSMOS_*",
    "FREE_MARKET_*",
    "INNGEST_*"
  ],
  "tasks": {
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "db:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "db:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "db:generate"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "db:generate"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": [
        "playwright-report/**"
      ]
    }
  }
}
